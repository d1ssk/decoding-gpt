---
import data from '../../public/site/data/nanogpt/probabilities.json';
import { entropy, nextTokenProbs, probabilityUi } from '../lib/probabilities';
import { charLabel } from '../lib/plot';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = probabilityUi[lang];
const chars = [...data.text];
const voc = data.vocabulary;
const V = voc.length;
const initial = 56;
const probs = nextTokenProbs(data.logits[initial], 1, V);
const ranked = probs
  .map((p, i) => [p, i] as const)
  .sort((a, b) => b[0] - a[0])
  .slice(0, 12);
const target = data.targets[initial];
const stageName = (name: string) =>
  name === 'embedding'
    ? ui.embedding
    : ui.afterBlock.replace('{n}', name.replace('block', ''));
const payload = JSON.stringify({
  logits: data.logits,
  vocabulary: voc,
  targets: data.targets,
  text: data.text,
  lens: data.logitLens.map((stage) => ({
    top: stage.top,
    target: stage.target,
  })),
});
---

<figure class="next-token" data-next-token data-payload={payload}>
  <figcaption>{ui.caption}</figcaption>
  <p class="note" id={`next-token-instruction-${lang}`}>
    {ui.instruction}
  </p>
  <div
    class="text"
    role="group"
    aria-describedby={`next-token-instruction-${lang}`}
  >
    {chars.map((char, t) => (
      <Fragment>
        <button
          type="button"
          data-position={t}
          aria-pressed={t === initial}
          aria-label={`${ui.position} ${t}: ${charLabel(char)}`}
          class:list={{ newline: char === '\n', context: initial >= t }}
          disabled
        >
          {charLabel(char)}
        </button>
        {char === '\n' && <br />}
      </Fragment>
    ))}
  </div>
  <div class="controls">
    <label>
      {ui.temperature}: <output data-temperature-value>1.00</output>
      <input
        data-temperature
        type="range"
        min="0.1"
        max="2"
        step="0.05"
        value="1"
        disabled
      />
    </label>
    <label>
      {ui.topK}: <output data-top-k-value>{V}</output>
      <input
        data-top-k
        type="range"
        min="1"
        max={V}
        step="1"
        value={V}
        disabled
      />
    </label>
  </div>
  <dl class="readout" aria-live="polite">
    <div>
      <dt>{ui.position}</dt>
      <dd data-readout="position">
        t = {initial} ({charLabel(chars[initial])})
      </dd>
    </div>
    <div>
      <dt>{ui.target}</dt>
      <dd data-readout="target">{charLabel(voc[target])}</dd>
    </div>
    <div>
      <dt>{ui.targetProb}</dt>
      <dd data-readout="targetProb">{probs[target].toFixed(4)}</dd>
    </div>
    <div>
      <dt>{ui.entropy}</dt>
      <dd data-readout="entropy">{entropy(probs).toFixed(3)}</dd>
    </div>
  </dl>
  <p class="label">{ui.candidates}</p>
  <ol class="bars">
    {ranked.map(([p, i]) => (
      <li data-bar class:list={{ target: i === target }}>
        <span class="char" data-char>
          {charLabel(voc[i])}
        </span>
        <span class="track">
          <span
            class="fill"
            data-fill
            style={`width: ${(p * 100).toFixed(2)}%`}
          />
        </span>
        <span class="value" data-value>
          {p.toFixed(4)}
        </span>
      </li>
    ))}
  </ol>
  <div class="sampling">
    <button type="button" data-sample disabled>
      {ui.sample}
    </button>
    <output data-samples aria-live="polite"></output>
  </div>
  <p class="note">{ui.note}</p>
  <div
    class="table-scroll"
    role="region"
    aria-label={ui.lensCaption}
    tabindex="0"
  >
    <table>
      <caption>{ui.lensCaption}</caption>
      <thead>
        <tr>
          <th scope="col">{ui.stage}</th>
          {[1, 2, 3, 4, 5].map((rank) => (
            <th scope="col">#{rank}</th>
          ))}
          <th scope="col">{ui.targetProb}</th>
        </tr>
      </thead>
      <tbody>
        {data.logitLens.map((stage, s) => (
          <tr>
            <th scope="row">{stageName(stage.name)}</th>
            {stage.top[initial].map(([i, p], r) => (
              <td data-lens={`${s}-${r}`}>
                {charLabel(voc[i])} {p.toFixed(3)}
              </td>
            ))}
            <td data-lens={`${s}-target`}>
              {stage.target[initial].toFixed(3)}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <noscript>
    <p class="note">{ui.noScript}</p>
  </noscript>
</figure>

<script>
  import { entropy, nextTokenProbs } from '../lib/probabilities';
  import { charLabel } from '../lib/plot';

  document
    .querySelectorAll<HTMLElement>('[data-next-token]')
    .forEach((root) => {
      const data = JSON.parse(root.dataset.payload!) as {
        logits: number[][];
        vocabulary: string[];
        targets: number[];
        text: string;
        lens: { top: [number, number][][]; target: number[] }[];
      };
      const chars = [...data.text];
      const voc = data.vocabulary;
      const temperature =
        root.querySelector<HTMLInputElement>('[data-temperature]')!;
      const topK = root.querySelector<HTMLInputElement>('[data-top-k]')!;
      const buttons =
        root.querySelectorAll<HTMLButtonElement>('[data-position]');
      const bars = root.querySelectorAll<HTMLElement>('[data-bar]');
      const samples = root.querySelector<HTMLOutputElement>('[data-samples]')!;
      let position = 56;
      let probs: number[] = [];
      const set = (name: string, value: string) => {
        root.querySelector(`[data-readout="${name}"]`)!.textContent = value;
      };

      const render = () => {
        const t = Number(temperature.value);
        const k = Number(topK.value);
        root.querySelector('[data-temperature-value]')!.textContent =
          t.toFixed(2);
        root.querySelector('[data-top-k-value]')!.textContent = String(k);
        probs = nextTokenProbs(data.logits[position], t, k);
        const target = data.targets[position];
        const ranked = probs
          .map((p, i) => [p, i] as const)
          .sort((a, b) => b[0] - a[0])
          .slice(0, bars.length);
        bars.forEach((bar, r) => {
          const [p, i] = ranked[r];
          bar.classList.toggle('target', i === target);
          bar.querySelector('[data-char]')!.textContent = charLabel(voc[i]);
          bar.querySelector<HTMLElement>('[data-fill]')!.style.width =
            `${(p * 100).toFixed(2)}%`;
          bar.querySelector('[data-value]')!.textContent = p.toFixed(4);
        });
        set('position', `t = ${position} (${charLabel(chars[position])})`);
        set('target', charLabel(voc[target]));
        set('targetProb', probs[target].toFixed(4));
        set('entropy', entropy(probs).toFixed(3));
        data.lens.forEach((stage, s) => {
          stage.top[position].forEach(([i, p], r) => {
            root.querySelector(`[data-lens="${s}-${r}"]`)!.textContent =
              `${charLabel(voc[i])} ${p.toFixed(3)}`;
          });
          root.querySelector(`[data-lens="${s}-target"]`)!.textContent =
            stage.target[position].toFixed(3);
        });
        buttons.forEach((button, i) => {
          button.setAttribute('aria-pressed', String(i === position));
          button.classList.toggle('context', i <= position);
        });
      };

      const draw = () => {
        let r = Math.random();
        for (let i = 0; i < probs.length; i++) {
          r -= probs[i];
          if (r <= 0) return i;
        }
        return probs.length - 1;
      };

      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener('click', () => {
          position = Number(button.dataset.position);
          samples.textContent = '';
          render();
        });
      });
      [temperature, topK].forEach((control) => {
        control.disabled = false;
        control.addEventListener('input', render);
      });
      const sample = root.querySelector<HTMLButtonElement>('[data-sample]')!;
      sample.disabled = false;
      sample.addEventListener('click', () => {
        samples.textContent = Array.from({ length: 20 }, () =>
          charLabel(voc[draw()]),
        ).join(' ');
      });
      render();
    });
</script>

<style>
  .next-token {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .note,
  .label {
    font-size: 0.8rem;
  }
  .note {
    color: var(--ink-secondary);
  }
  .text {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.9;
    margin: 0.75rem 0;
  }
  .text button {
    background: transparent;
    border: 1px solid transparent;
    color: var(--ink-muted);
    cursor: pointer;
    font: inherit;
    margin: 0;
    min-width: 1.05em;
    padding: 0 0.08em;
  }
  .text button.context {
    color: var(--ink);
  }
  .text button:disabled {
    cursor: default;
  }
  .text button.newline {
    font-size: 0.75em;
  }
  .text button[aria-pressed='true'] {
    background: var(--accent-light);
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .controls {
    display: grid;
    font-size: 0.85rem;
    gap: 0.5rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin: 1rem 0;
  }
  .controls label {
    display: grid;
    gap: 0.25rem;
  }
  output {
    font-family: var(--font-mono);
  }
  .readout {
    display: grid;
    font-size: 0.8rem;
    gap: 0.25rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    margin: 1rem 0;
  }
  .readout dt {
    color: var(--ink-muted);
  }
  .readout dd {
    font-family: var(--font-mono);
    margin: 0;
  }
  .bars {
    list-style: none;
    margin: 0.5rem 0 1rem;
    padding: 0;
  }
  .bars li {
    align-items: center;
    display: grid;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    gap: 0.6rem;
    grid-template-columns: 2rem minmax(0, 1fr) 4.5rem;
    margin: 0.15rem 0;
  }
  .bars .char {
    text-align: center;
  }
  .track {
    background: var(--paper-subtle);
    display: block;
    height: 0.8rem;
  }
  .fill {
    background: #276b92;
    display: block;
    height: 100%;
  }
  .bars li.target .fill {
    background: var(--accent);
  }
  .bars li.target .char {
    outline: 2px solid var(--accent);
  }
  .value {
    text-align: right;
  }
  .sampling {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1rem 0;
  }
  .sampling button {
    background: var(--paper);
    border: 1px solid var(--line-strong);
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
  }
  .sampling output {
    font-size: 0.85rem;
  }
  .table-scroll {
    overflow-x: auto;
  }
  table {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  caption {
    font-family: var(--font-body);
    font-size: 0.8rem;
    padding-bottom: 0.5rem;
    text-align: left;
    white-space: normal;
  }
</style>
