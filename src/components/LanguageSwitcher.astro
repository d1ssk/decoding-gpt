---
import type { Language } from '../lib/site';
import { useTranslations } from '../lib/i18n';

interface Props {
  lang: Language;
  alternateHref: string;
}

const { lang, alternateHref } = Astro.props;
const t = useTranslations(lang);
---

<nav class="language-switcher" aria-label={t.languageSwitcher}>
  <span aria-current="page">{t.currentLanguage}</span>
  <span class="language-divider" aria-hidden="true">
    /
  </span>
  <a
    href={alternateHref}
    lang={lang === 'ja' ? 'en' : 'ja'}
    hreflang={lang === 'ja' ? 'en' : 'ja'}
  >
    {t.otherLanguage}
  </a>
</nav>

<style>
  .language-switcher {
    align-items: center;
    display: flex;
    font-size: 0.78rem;
    gap: 0.55rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .language-switcher span[aria-current='page'] {
    color: var(--ink-muted);
  }

  .language-divider {
    color: var(--line-strong);
  }

  a {
    color: var(--ink);
    text-decoration: none;
    text-underline-offset: 0.22em;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
