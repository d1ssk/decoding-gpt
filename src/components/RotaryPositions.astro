---
import data from '../../public/site/data/nanogpt/nanochat-comparison.json';
import VectorArrow from './VectorArrow.astro';
import { dotColor, rotaryUi } from '../lib/nanochat';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = rotaryUi[lang];
const rot = data.rotary;
const half = rot.headDim / 2;
const pairs = [0, 1];
const initial = { m: 5, n: 2 };
const extent = 1.2;
const vector = (row: number[], i: number) => [row[i], row[i + half]];
const maxDot = Math.max(...rot.dots.flat().map(Math.abs));
const cell = 18;
const size = cell * rot.positions;
const pairLabel = (i: number) =>
  ui.pair
    .replace('{a}', String(i))
    .replace('{b}', String(i + half))
    .replace('{f}', String(Number(rot.invFreq[i].toPrecision(3))));
const payload = JSON.stringify({
  q: rot.rotatedQ,
  k: rot.rotatedK,
  dots: rot.dots,
  half,
  extent,
});
---

<figure class="rotary" data-rotary data-payload={payload}>
  <figcaption>{ui.caption}</figcaption>
  <div class="controls">
    <label>
      {ui.query}: <output data-m-value>{initial.m}</output>
      <input
        data-m
        type="range"
        min="0"
        max={rot.positions - 1}
        value={initial.m}
        disabled
      />
    </label>
    <label>
      {ui.key}: <output data-n-value>{initial.n}</output>
      <input
        data-n
        type="range"
        min="0"
        max={rot.positions - 1}
        value={initial.n}
        disabled
      />
    </label>
  </div>
  <div class="planes">
    {pairs.map((i) => (
      <div class="plane" data-pair={i}>
        <p>{pairLabel(i)}</p>
        <VectorArrow
          id={`rotary-${lang}-${i}`}
          vector={vector(rot.rotatedQ[initial.m], i)}
          color="#276b92"
          extent={extent}
          name="q"
          overlay={{
            vector: vector(rot.rotatedK[initial.n], i),
            color: '#a05a20',
            name: 'k',
          }}
          label={pairLabel(i)}
        />
      </div>
    ))}
  </div>
  <dl class="readout" aria-live="polite">
    <div>
      <dt>{ui.offset}</dt>
      <dd data-offset>{initial.m - initial.n}</dd>
    </div>
    <div>
      <dt>{ui.dot}</dt>
      <dd data-dot>{rot.dots[initial.m][initial.n].toFixed(4)}</dd>
    </div>
  </dl>
  <p class="label">{ui.table}</p>
  <svg
    class="table"
    viewBox={`0 0 ${size + 24} ${size + 24}`}
    role="img"
    aria-label={ui.table}
  >
    {rot.dots.map((row, m) =>
      row.map((value, n) => (
        <rect
          x={24 + n * cell}
          y={24 + m * cell}
          width={cell - 1}
          height={cell - 1}
          fill={dotColor(value, maxDot)}
        >
          <title>{`m=${m}, n=${n}: ${value}`}</title>
        </rect>
      )),
    )}
    {Array.from({ length: rot.positions }, (_, i) => (
      <>
        <text
          x={24 + i * cell + cell / 2}
          y={16}
          class="tick"
          text-anchor="middle"
        >
          {i}
        </text>
        <text
          x={16}
          y={24 + i * cell + cell / 2 + 3}
          class="tick"
          text-anchor="end"
        >
          {i}
        </text>
      </>
    ))}
    <rect
      data-mark
      x={24 + initial.n * cell - 1}
      y={24 + initial.m * cell - 1}
      width={cell + 1}
      height={cell + 1}
      class="mark"
    />
  </svg>
  <p class="note">{ui.tableNote}</p>
  <p class="note">{ui.note}</p>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-rotary]').forEach((root) => {
    const { q, k, dots, half, extent } = JSON.parse(root.dataset.payload!) as {
      q: number[][];
      k: number[][];
      dots: number[][];
      half: number;
      extent: number;
    };
    const mInput = root.querySelector<HTMLInputElement>('[data-m]')!;
    const nInput = root.querySelector<HTMLInputElement>('[data-n]')!;
    const scale = 60 / extent;
    const place = (line: Element, v: number[]) => {
      line.setAttribute('x2', String(80 + scale * v[0]));
      line.setAttribute('y2', String(80 - scale * v[1]));
    };
    const render = () => {
      const m = Number(mInput.value);
      const n = Number(nInput.value);
      root.querySelector('[data-m-value]')!.textContent = String(m);
      root.querySelector('[data-n-value]')!.textContent = String(n);
      root.querySelectorAll<HTMLElement>('[data-pair]').forEach((plane) => {
        const i = Number(plane.dataset.pair);
        place(plane.querySelector('[data-vector-line]')!, [
          q[m][i],
          q[m][i + half],
        ]);
        place(plane.querySelector('[data-overlay-line]')!, [
          k[n][i],
          k[n][i + half],
        ]);
      });
      root.querySelector('[data-offset]')!.textContent = String(m - n);
      root.querySelector('[data-dot]')!.textContent = dots[m][n].toFixed(4);
      const mark = root.querySelector('[data-mark]')!;
      mark.setAttribute('x', String(24 + n * 18 - 1));
      mark.setAttribute('y', String(24 + m * 18 - 1));
    };
    [mInput, nInput].forEach((input) => {
      input.disabled = false;
      input.addEventListener('input', render);
    });
  });
</script>

<style>
  .rotary {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .controls {
    display: grid;
    font-size: 0.85rem;
    gap: 0.5rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }
  .controls label {
    display: grid;
    gap: 0.25rem;
  }
  output {
    font-family: var(--font-mono);
  }
  .planes {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 12rem));
    margin: 1rem 0;
  }
  .plane p,
  .label,
  .note {
    font-size: 0.8rem;
    margin: 0.25rem 0;
  }
  .note {
    color: var(--ink-secondary);
  }
  .readout {
    display: grid;
    font-size: 0.8rem;
    gap: 0.25rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    margin: 1rem 0;
  }
  .readout dt {
    color: var(--ink-muted);
  }
  .readout dd {
    font-family: var(--font-mono);
    margin: 0;
  }
  .table {
    display: block;
    height: auto;
    max-width: 22rem;
    width: 100%;
  }
  .tick {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 8px;
  }
  .mark {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
</style>
