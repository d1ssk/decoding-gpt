---
import training from '../../public/site/data/nanogpt/tiny-training.json';
import { backpropUi, parameterLabel } from '../lib/backprop';
import { logScale } from '../lib/plot';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = backpropUi[lang];
const snapshots = training.gradientNorms;
const names = Object.keys(snapshots[0].norms);
const width = 600;
const rowHeight = 16;
const left = 150;
const right = 60;
const top = 20;
const height = top + names.length * rowHeight + 8;
const x = logScale([1e-3, 10], [left, width - right]);
const ticks = [1e-3, 1e-2, 1e-1, 1, 10];
const barWidth = (value: number) =>
  Math.max(0, x(Math.max(value, 1e-3)) - left);
const initial = 0;
const values = snapshots.map((s) =>
  names.map((n) => (s.norms as Record<string, number>)[n]),
);
const iterationLabel = (n: number) =>
  ui.iteration.replace('{n}', n.toLocaleString('en-US'));
---

<figure
  class="gradient-norms"
  data-gradient-norms
  data-values={JSON.stringify(values.map((row) => row.map(barWidth)))}
  data-raw={JSON.stringify(values)}
>
  <figcaption>{ui.normsCaption}</figcaption>
  <fieldset>
    {snapshots.map((s, i) => (
      <label>
        <input
          type="radio"
          name={`grad-norms-${lang}`}
          value={i}
          checked={i === initial}
          disabled
        />
        {iterationLabel(s.iter)}
      </label>
    ))}
  </fieldset>
  <svg
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={ui.normsCaption}
  >
    {ticks.map((v) => (
      <>
        <path d={`M${x(v)} ${top - 6}V${height - 4}`} class="grid" />
        <text x={x(v)} y={top - 9} class="tick" text-anchor="middle">
          {v >= 1 ? v : v.toExponential(0)}
        </text>
      </>
    ))}
    {names.map((name, i) => (
      <>
        <text
          x={left - 6}
          y={top + i * rowHeight + 11}
          class="name"
          text-anchor="end"
        >
          {parameterLabel(name)}
        </text>
        <rect
          data-bar={i}
          x={left}
          y={top + i * rowHeight + 3}
          height={rowHeight - 6}
          width={barWidth(values[initial][i])}
          class:list={['bar', { ln: name.includes('ln_') }]}
        />
        <text
          data-value={i}
          x={left + barWidth(values[initial][i]) + 4}
          y={top + i * rowHeight + 11}
          class="value"
        >
          {values[initial][i].toPrecision(3)}
        </text>
      </>
    ))}
  </svg>
  <p class="note">{ui.normsNote}</p>
</figure>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-gradient-norms]')
    .forEach((root) => {
      const widths = JSON.parse(root.dataset.values!) as number[][];
      const raw = JSON.parse(root.dataset.raw!) as number[][];
      const left = 150;
      root.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        input.disabled = false;
        input.addEventListener('change', () => {
          const s = Number(input.value);
          widths[s].forEach((w, i) => {
            root
              .querySelector(`[data-bar="${i}"]`)!
              .setAttribute('width', String(w));
            const label = root.querySelector(`[data-value="${i}"]`)!;
            label.setAttribute('x', String(left + w + 4));
            label.textContent = raw[s][i].toPrecision(3);
          });
        });
      });
    });
</script>

<style>
  .gradient-norms {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  fieldset {
    border: 0;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.85rem;
    gap: 0.4rem 1.1rem;
    margin: 0 0 0.75rem;
    padding: 0;
  }
  label {
    align-items: center;
    display: inline-flex;
    gap: 0.25rem;
  }
  .note {
    color: var(--ink-secondary);
    font-size: 0.8rem;
  }
  svg {
    display: block;
    height: auto;
    width: 100%;
  }
  .grid {
    stroke: var(--line);
    stroke-width: 0.6;
  }
  .tick,
  .name,
  .value {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .name {
    fill: var(--ink-secondary);
  }
  .bar {
    fill: var(--accent);
    fill-opacity: 0.75;
  }
  .bar.ln {
    fill: #7a4d8c;
  }
</style>
