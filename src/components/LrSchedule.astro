---
import training from '../../public/site/data/nanogpt/tiny-training.json';
import { getLr, trainingUi } from '../lib/training';
import { linearScale, linePath, ticks } from '../lib/plot';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = trainingUi[lang];
const cfg = training.config;
const initial = {
  learning_rate: cfg.learning_rate,
  warmup_iters: cfg.warmup_iters,
  lr_decay_iters: cfg.lr_decay_iters,
  min_lr: cfg.min_lr,
};
const maxIters = cfg.max_iters;
const width = 600;
const height = 240;
const margin = { left: 58, right: 12, top: 12, bottom: 36 };
const x = linearScale([0, maxIters], [margin.left, width - margin.right]);
const yMax = 0.002;
const y = linearScale([0, yMax], [height - margin.bottom, margin.top]);
const curve = (c: typeof initial) =>
  linePath(
    Array.from({ length: 201 }, (_, i) => {
      const it = Math.round((i * maxIters) / 200);
      return [it, getLr(it, c)] as [number, number];
    }),
    x,
    y,
  );
const actual = linePath(
  training.history
    .filter((_, i) => i % 10 === 0)
    .map((row) => [row[0], row[1]] as [number, number]),
  x,
  y,
);
const controls = [
  {
    key: 'learning_rate',
    label: ui.learningRate,
    min: 0.0001,
    max: 0.002,
    step: 0.0001,
  },
  { key: 'warmup_iters', label: ui.warmup, min: 0, max: 1000, step: 10 },
  { key: 'lr_decay_iters', label: ui.decay, min: 200, max: 4000, step: 50 },
  { key: 'min_lr', label: ui.minLr, min: 0, max: 0.001, step: 0.00001 },
] as const;
const format = (key: string, value: number) =>
  key.endsWith('iters') ? String(value) : value.toExponential(1);
---

<figure
  class="lr-schedule"
  data-lr-schedule
  data-initial={JSON.stringify(initial)}
  data-max-iters={maxIters}
>
  <figcaption>{ui.lrCaption}</figcaption>
  <div class="controls">
    {controls.map((c) => (
      <label>
        <span>
          <code>{c.label}</code>:{' '}
          <output data-output={c.key}>{format(c.key, initial[c.key])}</output>
        </span>
        <input
          type="range"
          data-control={c.key}
          min={c.min}
          max={c.max}
          step={c.step}
          value={initial[c.key]}
          disabled
        />
      </label>
    ))}
  </div>
  <button type="button" data-reset disabled>
    {ui.reset}
  </button>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={ui.lrCaption}>
    {ticks(0, yMax, 4).map((v) => (
      <>
        <path
          d={`M${margin.left} ${y(v)}H${width - margin.right}`}
          class="grid"
        />
        <text x={margin.left - 6} y={y(v) + 4} class="tick" text-anchor="end">
          {v === 0 ? '0' : v.toExponential(1)}
        </text>
      </>
    ))}
    {ticks(0, maxIters, 4).map((v) => (
      <text
        x={x(v)}
        y={height - margin.bottom + 16}
        class="tick"
        text-anchor="middle"
      >
        {v}
      </text>
    ))}
    <text
      x={width - margin.right}
      y={height - 4}
      class="tick"
      text-anchor="end"
    >
      {ui.iteration}
    </text>
    <path data-curve d={curve(initial)} class="curve" />
    <path d={actual} class="actual" />
  </svg>
  <p class="legend">
    <span class="item">
      <span class="key computed"></span>
      {ui.computed}
    </span>
    <span class="item">
      <span class="key actual-key"></span>
      {ui.actual}
    </span>
  </p>
  <p class="note">{ui.lrNote}</p>
</figure>

<script>
  import { getLr, type LrConfig } from '../lib/training';
  import { linearScale, linePath } from '../lib/plot';

  document
    .querySelectorAll<HTMLElement>('[data-lr-schedule]')
    .forEach((root) => {
      const initial = JSON.parse(root.dataset.initial!) as LrConfig;
      const maxIters = Number(root.dataset.maxIters);
      const x = linearScale([0, maxIters], [58, 588]);
      const y = linearScale([0, 0.002], [204, 12]);
      const inputs = [
        ...root.querySelectorAll<HTMLInputElement>('[data-control]'),
      ];
      const read = () =>
        Object.fromEntries(
          inputs.map((i) => [i.dataset.control!, Number(i.value)]),
        ) as unknown as LrConfig;
      const render = () => {
        const c = read();
        if (c.lr_decay_iters <= c.warmup_iters)
          c.lr_decay_iters = c.warmup_iters + 1;
        inputs.forEach((i) => {
          const key = i.dataset.control!;
          const value = Number(i.value);
          root.querySelector(`[data-output="${key}"]`)!.textContent =
            key.endsWith('iters') ? String(value) : value.toExponential(1);
        });
        const points = Array.from({ length: 201 }, (_, k) => {
          const it = Math.round((k * maxIters) / 200);
          return [it, Math.min(getLr(it, c), 0.002)] as [number, number];
        });
        root
          .querySelector('[data-curve]')!
          .setAttribute('d', linePath(points, x, y));
      };
      inputs.forEach((input) => {
        input.disabled = false;
        input.addEventListener('input', render);
      });
      const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
      reset.disabled = false;
      reset.addEventListener('click', () => {
        inputs.forEach((i) => {
          i.value = String(initial[i.dataset.control as keyof LrConfig]);
        });
        render();
      });
    });
</script>

<style>
  .lr-schedule {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .controls {
    display: grid;
    font-size: 0.8rem;
    gap: 0.6rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .controls label {
    display: grid;
    gap: 0.2rem;
  }
  output {
    font-family: var(--font-mono);
  }
  button {
    background: var(--paper);
    border: 1px solid var(--line-strong);
    cursor: pointer;
    font: inherit;
    font-size: 0.8rem;
    margin: 0.8rem 0;
    padding: 0.3rem 0.7rem;
  }
  svg {
    display: block;
    height: auto;
    width: 100%;
  }
  .grid {
    stroke: var(--line);
    stroke-width: 0.7;
  }
  .tick {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .curve {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
  }
  .actual {
    fill: none;
    stroke: #a05a20;
    stroke-dasharray: 5 4;
    stroke-width: 1.5;
  }
  .legend,
  .note {
    font-size: 0.8rem;
  }
  .note {
    color: var(--ink-secondary);
  }
  .legend {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
  }
  .item {
    align-items: center;
    display: inline-flex;
    gap: 0.4rem;
  }
  .key {
    display: inline-block;
    height: 0;
    width: 1.4rem;
  }
  .computed {
    border-top: 3px solid var(--accent);
  }
  .actual-key {
    border-top: 2px dashed #a05a20;
  }
</style>
