---
import data from '../../public/site/data/nanogpt/multi-head-attention.json';
import { attentionHeadsUi } from '../lib/multi-head';
import { charLabel } from '../lib/plot';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = attentionHeadsUi[lang];
const chars = [...data.text];
const T = chars.length;
const L = data.attentionPerMille.length;
const H = data.attentionPerMille[0].length;
const initial = { layer: 1, head: 3, position: 61 };
const row = data.attentionPerMille[initial.layer][initial.head];
const size = 4 + T * 6 + 4;
const stat = data.headStats[initial.layer][initial.head];
const payload = JSON.stringify({
  maps: data.attentionPerMille,
  stats: data.headStats,
  text: data.text,
});
const top = (weights: number[], position: number) =>
  weights
    .map((w, j) => [w, j] as const)
    .sort((a, b) => b[0] - a[0])
    .slice(0, 3)
    .map(
      ([w, j]) =>
        `${j}:${charLabel(chars[j])} ${(w / 1000).toFixed(3)}${j === position ? '*' : ''}`,
    )
    .join(' · ');
const format = (value: number) => value.toFixed(3);
const initialWeights = chars.map(
  (_, t) => (row[initial.position][t] ?? 0) / 1000,
);
---

<figure
  class="attention-heads"
  data-attention-heads
  data-payload={payload}
  data-initial={JSON.stringify(initial)}
>
  <figcaption>{ui.caption}</figcaption>
  <div class="selectors">
    <fieldset>
      <legend>{ui.layer}</legend>
      {Array.from({ length: L }, (_, l) => (
        <label>
          <input
            type="radio"
            name={`attn-layer-${lang}`}
            value={l}
            checked={l === initial.layer}
            data-layer
            disabled
          />
          {l}
        </label>
      ))}
    </fieldset>
    <fieldset>
      <legend>{ui.head}</legend>
      {Array.from({ length: H }, (_, h) => (
        <label>
          <input
            type="radio"
            name={`attn-head-${lang}`}
            value={h}
            checked={h === initial.head}
            data-head
            disabled
          />
          {h}
        </label>
      ))}
    </fieldset>
  </div>
  <p class="instruction" id={`attn-instruction-${lang}`}>
    {ui.instruction}
  </p>
  <div class="text" role="group" aria-describedby={`attn-instruction-${lang}`}>
    {chars.map((char, t) => (
      <Fragment>
        <button
          type="button"
          data-position={t}
          aria-pressed={t === initial.position}
          aria-label={`${ui.position} ${t}: ${charLabel(char)}`}
          style={`--w: ${initialWeights[t]}`}
          class:list={{ newline: char === '\n' }}
          disabled
        >
          {charLabel(char)}
        </button>
        {char === '\n' && <br />}
      </Fragment>
    ))}
  </div>
  <dl class="readout" aria-live="polite">
    <div>
      <dt>{ui.selected}</dt>
      <dd data-readout="position">
        t = {initial.position} ({charLabel(chars[initial.position])})
      </dd>
    </div>
    <div>
      <dt>{ui.weightsTo}</dt>
      <dd data-readout="top">{top(row[initial.position], initial.position)}</dd>
    </div>
    <div>
      <dt>{ui.meanDistance}</dt>
      <dd data-readout="meanDistance">{stat.meanDistance.toFixed(2)}</dd>
    </div>
    <div>
      <dt>{ui.previousWeight}</dt>
      <dd data-readout="previousWeight">{format(stat.previousWeight)}</dd>
    </div>
    <div>
      <dt>{ui.selfWeight}</dt>
      <dd data-readout="selfWeight">{format(stat.selfWeight)}</dd>
    </div>
    <div>
      <dt>{ui.ablation}</dt>
      <dd data-readout="ablationDelta">+{format(stat.ablationDelta)}</dd>
    </div>
  </dl>
  <p class="map-label">{ui.heatmap}</p>
  <canvas
    data-heatmap
    width={size * 4}
    height={size * 4}
    role="img"
    aria-label={ui.heatmap}
  ></canvas>
  <details>
    <summary>{ui.allHeads}</summary>
    <div
      class="table-scroll"
      role="region"
      aria-label={ui.allHeads}
      tabindex="0"
    >
      <table>
        <thead>
          <tr>
            <th scope="col">{ui.layer}</th>
            <th scope="col">{ui.head}</th>
            <th scope="col">{ui.meanDistance}</th>
            <th scope="col">{ui.previousWeight}</th>
            <th scope="col">{ui.selfWeight}</th>
            <th scope="col">{ui.ablation}</th>
          </tr>
        </thead>
        <tbody>
          {data.headStats.flatMap((heads, l) =>
            heads.map((s, h) => (
              <tr>
                <td>{l}</td>
                <td>{h}</td>
                <td>{s.meanDistance.toFixed(2)}</td>
                <td>{format(s.previousWeight)}</td>
                <td>{format(s.selfWeight)}</td>
                <td>+{format(s.ablationDelta)}</td>
              </tr>
            )),
          )}
        </tbody>
      </table>
    </div>
    <p class="note">
      {ui.statsNote} <code>{data.baselineLoss.toFixed(4)}</code>.
    </p>
  </details>
  <noscript>
    <p class="note">{ui.noScript}</p>
  </noscript>
</figure>

<script>
  import { charLabel } from '../lib/plot';

  interface Stat {
    meanDistance: number;
    selfWeight: number;
    previousWeight: number;
    ablationDelta: number;
  }

  document
    .querySelectorAll<HTMLElement>('[data-attention-heads]')
    .forEach((root) => {
      const { maps, stats, text } = JSON.parse(root.dataset.payload!) as {
        maps: number[][][][];
        stats: Stat[][];
        text: string;
      };
      const chars = [...text];
      const state = JSON.parse(root.dataset.initial!) as {
        layer: number;
        head: number;
        position: number;
      };
      const buttons =
        root.querySelectorAll<HTMLButtonElement>('[data-position]');
      const canvas = root.querySelector<HTMLCanvasElement>('[data-heatmap]')!;
      const context = canvas.getContext('2d')!;
      const styles = getComputedStyle(root);
      const set = (name: string, value: string) => {
        root.querySelector(`[data-readout="${name}"]`)!.textContent = value;
      };

      // 4 device pixels per unit; each cell is 6 units with a 4-unit margin.
      const drawMap = () => {
        const unit = 4;
        const map = maps[state.layer][state.head];
        const T = map.length;
        context.setTransform(unit, 0, 0, unit, 0, 0);
        context.clearRect(0, 0, canvas.width, canvas.height);
        context.fillStyle = styles.getPropertyValue('--paper-subtle');
        context.fillRect(4, 4, T * 6, T * 6);
        context.fillStyle = styles.getPropertyValue('--accent');
        map.forEach((weights, t) =>
          weights.forEach((w, j) => {
            context.globalAlpha = Math.min(1, w / 600);
            context.fillRect(4 + j * 6, 4 + t * 6, 6, 6);
          }),
        );
        context.globalAlpha = 1;
        context.strokeStyle = '#a05a20';
        context.lineWidth = 1;
        context.strokeRect(4, 4 + state.position * 6, T * 6, 6);
      };

      const renderMap = () => {
        const s = stats[state.layer][state.head];
        set('meanDistance', s.meanDistance.toFixed(2));
        set('previousWeight', s.previousWeight.toFixed(3));
        set('selfWeight', s.selfWeight.toFixed(3));
        set('ablationDelta', `+${s.ablationDelta.toFixed(3)}`);
      };

      const renderRow = () => {
        const row = maps[state.layer][state.head][state.position];
        buttons.forEach((button, t) => {
          const w = t <= state.position ? row[t] / 1000 : 0;
          button.style.setProperty('--w', String(w));
          button.setAttribute('aria-pressed', String(t === state.position));
        });
        drawMap();
        set(
          'position',
          `t = ${state.position} (${charLabel(chars[state.position])})`,
        );
        set(
          'top',
          row
            .map((w, j) => [w, j] as const)
            .sort((a, b) => b[0] - a[0])
            .slice(0, 3)
            .map(
              ([w, j]) =>
                `${j}:${charLabel(chars[j])} ${(w / 1000).toFixed(3)}${j === state.position ? '*' : ''}`,
            )
            .join(' · '),
        );
      };

      drawMap();
      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener('click', () => {
          state.position = Number(button.dataset.position);
          renderRow();
        });
      });
      root
        .querySelectorAll<HTMLInputElement>('[data-layer], [data-head]')
        .forEach((input) => {
          input.disabled = false;
          input.addEventListener('change', () => {
            if (input.hasAttribute('data-layer'))
              state.layer = Number(input.value);
            else state.head = Number(input.value);
            renderMap();
            renderRow();
          });
        });
    });
</script>

<style>
  .attention-heads {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .selectors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }
  fieldset {
    border: 0;
    display: flex;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    font-size: 0.85rem;
  }
  legend {
    float: left;
    margin-right: 0.6rem;
  }
  label {
    align-items: center;
    display: inline-flex;
    font-family: var(--font-mono);
    gap: 0.2rem;
  }
  .instruction,
  .map-label,
  .note {
    color: var(--ink-secondary);
    font-size: 0.8rem;
  }
  .text {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.9;
    margin: 0.75rem 0;
  }
  .text button {
    background: rgba(30, 91, 73, calc(var(--w) * 0.85));
    border: 1px solid transparent;
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    margin: 0;
    min-width: 1.05em;
    padding: 0 0.08em;
  }
  .text button:disabled {
    cursor: default;
  }
  .text button.newline {
    color: var(--ink-muted);
    font-size: 0.75em;
  }
  .text button[aria-pressed='true'] {
    border-color: var(--ink);
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .readout {
    display: grid;
    font-size: 0.8rem;
    gap: 0.25rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    margin: 1rem 0;
  }
  .readout dt {
    color: var(--ink-muted);
  }
  .readout dd {
    font-family: var(--font-mono);
    margin: 0;
  }
  canvas {
    aspect-ratio: 1;
    display: block;
    height: auto;
    max-width: 26rem;
    width: 100%;
  }
  details {
    margin-top: 1rem;
  }
  summary {
    cursor: pointer;
    font-size: 0.85rem;
  }
  .table-scroll {
    overflow-x: auto;
  }
  table {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }
</style>
