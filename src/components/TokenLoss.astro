---
import data from '../../public/site/data/nanogpt/loss.json';
import { lossColor, lossUi } from '../lib/loss';
import { charLabel } from '../lib/plot';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = lossUi[lang];
const voc = data.vocabulary;
// Character k (k >= 1) is predicted at position k - 1.
const shown = [data.text[0], ...data.targets.map((id) => voc[id])];
const snapshots = data.snapshots;
const initialSnapshot = snapshots.length - 1;
const initialPrediction = 56;
const snap = snapshots[initialSnapshot];
const mean = (values: number[]) =>
  values.reduce((a, b) => a + b, 0) / values.length;
const iterationLabel = (n: number) =>
  ui.iteration.replace('{n}', n.toLocaleString('en-US'));
const topText = (top: number[][]) =>
  top.map(([i, p]) => `${charLabel(voc[i])} ${p.toFixed(3)}`).join(' · ');
const payload = JSON.stringify({
  vocabulary: voc,
  text: data.text,
  targets: data.targets,
  snapshots: snapshots.map((s) => ({
    perPosition: s.perPosition,
    targetProb: s.targetProb,
    top: s.top,
    valLoss: s.valLoss,
  })),
});
---

<figure
  class="token-loss"
  data-token-loss
  data-payload={payload}
  data-initial={JSON.stringify([initialSnapshot, initialPrediction])}
  data-context-label={ui.context}
>
  <figcaption>{ui.stripCaption}</figcaption>
  <fieldset>
    <legend>{ui.snapshot}</legend>
    {snapshots.map((s, i) => (
      <label>
        <input
          type="radio"
          name={`loss-snapshot-${lang}`}
          value={i}
          checked={i === initialSnapshot}
          disabled
        />
        {iterationLabel(s.iter)}
      </label>
    ))}
  </fieldset>
  <p class="note" id={`token-loss-note-${lang}`}>
    {ui.stripNote}
  </p>
  <div class="text" role="group" aria-describedby={`token-loss-note-${lang}`}>
    {shown.map((char, k) => (
      <Fragment>
        {k === 0 ? (
          <span class="first">{charLabel(char)}</span>
        ) : (
          <button
            type="button"
            data-prediction={k - 1}
            aria-pressed={k - 1 === initialPrediction}
            aria-label={`${ui.position} ${k}: ${charLabel(char)}`}
            class:list={{ newline: char === '\n' }}
            style={`background: ${lossColor(snap.perPosition[k - 1])}`}
            disabled
          >
            {charLabel(char)}
          </button>
        )}
        {char === '\n' && <br />}
      </Fragment>
    ))}
  </div>
  <dl class="readout" aria-live="polite">
    <div>
      <dt>{ui.selected}</dt>
      <dd data-readout="selected">
        {charLabel(shown[initialPrediction + 1])} ({ui.context}:{' '}
        {charLabel(data.text[initialPrediction])})
      </dd>
    </div>
    <div>
      <dt>{ui.prob}</dt>
      <dd data-readout="prob">
        {snap.targetProb[initialPrediction].toFixed(4)}
      </dd>
    </div>
    <div>
      <dt>{ui.loss}</dt>
      <dd data-readout="loss">
        {snap.perPosition[initialPrediction].toFixed(3)}
      </dd>
    </div>
    <div>
      <dt>{ui.top}</dt>
      <dd data-readout="top">{topText(snap.top[initialPrediction])}</dd>
    </div>
    <div>
      <dt>{ui.meanLoss}</dt>
      <dd data-readout="mean">{mean(snap.perPosition).toFixed(3)}</dd>
    </div>
    <div>
      <dt>{ui.valLoss}</dt>
      <dd data-readout="val">{snap.valLoss.toFixed(3)}</dd>
    </div>
    <div>
      <dt>{ui.uniform}</dt>
      <dd>{data.uniformLoss.toFixed(3)}</dd>
    </div>
  </dl>
  <noscript>
    <p class="note">{ui.noScript}</p>
  </noscript>
</figure>

<script>
  import { lossColor } from '../lib/loss';
  import { charLabel } from '../lib/plot';

  document
    .querySelectorAll<HTMLElement>('[data-token-loss]')
    .forEach((root) => {
      const data = JSON.parse(root.dataset.payload!) as {
        vocabulary: string[];
        text: string;
        targets: number[];
        snapshots: {
          perPosition: number[];
          targetProb: number[];
          top: [number, number][][];
          valLoss: number;
        }[];
      };
      const voc = data.vocabulary;
      const chars = [...data.text];
      let [snapshot, prediction] = JSON.parse(
        root.dataset.initial!,
      ) as number[];
      const buttons =
        root.querySelectorAll<HTMLButtonElement>('[data-prediction]');
      const set = (name: string, value: string) => {
        root.querySelector(`[data-readout="${name}"]`)!.textContent = value;
      };
      const contextLabel = root.dataset.contextLabel!;
      const render = () => {
        const s = data.snapshots[snapshot];
        buttons.forEach((button, t) => {
          button.style.background = lossColor(s.perPosition[t]);
          button.setAttribute('aria-pressed', String(t === prediction));
        });
        set(
          'selected',
          `${charLabel(voc[data.targets[prediction]])} (${contextLabel}: ${charLabel(chars[prediction])})`,
        );
        set('prob', s.targetProb[prediction].toFixed(4));
        set('loss', s.perPosition[prediction].toFixed(3));
        set(
          'top',
          s.top[prediction]
            .map(([i, p]) => `${charLabel(voc[i])} ${p.toFixed(3)}`)
            .join(' · '),
        );
        set(
          'mean',
          (
            s.perPosition.reduce((a, b) => a + b, 0) / s.perPosition.length
          ).toFixed(3),
        );
        set('val', s.valLoss.toFixed(3));
      };
      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener('click', () => {
          prediction = Number(button.dataset.prediction);
          render();
        });
      });
      root
        .querySelectorAll<HTMLInputElement>('input[type="radio"]')
        .forEach((input) => {
          input.disabled = false;
          input.addEventListener('change', () => {
            snapshot = Number(input.value);
            render();
          });
        });
    });
</script>

<style>
  .token-loss {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  fieldset {
    border: 0;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.85rem;
    gap: 0.4rem 1.1rem;
    margin: 0;
    padding: 0;
  }
  legend {
    float: left;
    margin-right: 0.6rem;
  }
  label {
    align-items: center;
    display: inline-flex;
    gap: 0.25rem;
  }
  .note {
    color: var(--ink-secondary);
    font-size: 0.8rem;
  }
  .text {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.9;
    margin: 0.75rem 0;
  }
  .first {
    color: var(--ink-muted);
    padding: 0 0.08em;
  }
  .text button {
    border: 1px solid transparent;
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    margin: 0;
    min-width: 1.05em;
    padding: 0 0.08em;
  }
  .text button:disabled {
    cursor: default;
  }
  .text button.newline {
    font-size: 0.75em;
  }
  .text button[aria-pressed='true'] {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .readout {
    display: grid;
    font-size: 0.8rem;
    gap: 0.25rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin: 1rem 0;
  }
  .readout dt {
    color: var(--ink-muted);
  }
  .readout dd {
    font-family: var(--font-mono);
    margin: 0;
  }
</style>
