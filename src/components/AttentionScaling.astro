---
import data from '../../public/site/data/nanogpt/attention-scaling.json';
import { attentionScalingUi } from '../lib/attention-scaling';
import { linearScale, linePath, logScale } from '../lib/plot';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = attentionScalingUi[lang];
const rows = data.random;
const dims = rows.map((r) => r.d);
const width = 600;
const height = 210;
const margin = { left: 40, right: 110, top: 12, bottom: 36 };
const x = logScale(
  [dims[0], dims[dims.length - 1]],
  [margin.left, width - margin.right],
);

type Metric = 'scoreStd' | 'effectivePositions';
const panels: {
  metric: Metric;
  caption: string;
  max: number;
  ticks: number[];
}[] = [
  {
    metric: 'scoreStd',
    caption: ui.stdCaption,
    max: 17,
    ticks: [0, 4, 8, 12, 16],
  },
  {
    metric: 'effectivePositions',
    caption: ui.effectiveCaption,
    max: 64,
    ticks: [0, 16, 32, 48, 64],
  },
];
const series = [
  { key: 'raw' as const, label: ui.raw },
  { key: 'scaled' as const, label: ui.scaled },
];
---

<figure class="attention-scaling">
  <figcaption>{ui.caption}</figcaption>
  {panels.map((panel) => {
    const y = linearScale([0, panel.max], [height - margin.bottom, margin.top]);
    return (
      <>
        <p class="subcaption">{panel.caption}</p>
        <svg
          viewBox={`0 0 ${width} ${height}`}
          role="img"
          aria-label={panel.caption}
        >
          {panel.ticks.map((v) => (
            <>
              <path
                d={`M${margin.left} ${y(v)}H${width - margin.right}`}
                class:list={['grid', { zero: v === 0 }]}
              />
              <text
                x={margin.left - 6}
                y={y(v) + 4}
                class="tick"
                text-anchor="end"
              >
                {v}
              </text>
            </>
          ))}
          {dims.map((d) => (
            <text
              x={x(d)}
              y={height - margin.bottom + 15}
              class="tick"
              text-anchor="middle"
            >
              {d}
            </text>
          ))}
          {series.map(({ key, label }) => {
            const points = rows.map(
              (r) => [r.d, r[key][panel.metric]] as [number, number],
            );
            const lastPoint = points[points.length - 1];
            return (
              <g class={key}>
                <path d={linePath(points, x, y)} class="line" />
                {points.map(([d, v]) => (
                  <circle cx={x(d)} cy={y(v)} r="4" class="dot">
                    <title>{`${label}, d = ${d}: ${v.toFixed(2)}`}</title>
                  </circle>
                ))}
                <text
                  x={x(lastPoint[0]) + 10}
                  y={y(lastPoint[1]) + 4}
                  class="direct-label"
                >
                  {key === 'raw' ? 'q · k' : 'q · k / √d'}
                </text>
              </g>
            );
          })}
          <text
            x={width - margin.right}
            y={height - 4}
            class="tick"
            text-anchor="end"
          >
            {ui.d}
          </text>
        </svg>
      </>
    );
  })}
  <p class="legend">
    {series.map(({ key, label }) => (
      <span class="item">
        <span class:list={['key', key]}></span>
        {label}
      </span>
    ))}
  </p>
  <p class="note">{ui.note}</p>
  <details>
    <summary>{ui.table}</summary>
    <div class="table-scroll" role="region" aria-label={ui.table} tabindex="0">
      <table>
        <thead>
          <tr>
            <th scope="col" rowspan="2">
              d
            </th>
            <th scope="colgroup" colspan="3">
              {ui.raw}
            </th>
            <th scope="colgroup" colspan="3">
              {ui.scaled}
            </th>
          </tr>
          <tr>
            {[0, 1].map(() => (
              <>
                <th scope="col">{ui.std}</th>
                <th scope="col">{ui.effective}</th>
                <th scope="col">{ui.maxWeight}</th>
              </>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td>{r.d}</td>
              {[r.raw, r.scaled].map((m) => (
                <>
                  <td>{m.scoreStd.toFixed(2)}</td>
                  <td>{m.effectivePositions.toFixed(1)}</td>
                  <td>{m.maxWeight.toFixed(3)}</td>
                </>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .attention-scaling {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .subcaption {
    font-size: 0.85rem;
    margin: 1rem 0 0.25rem;
  }
  svg {
    display: block;
    height: auto;
    width: 100%;
  }
  .grid {
    stroke: var(--line);
    stroke-width: 0.7;
  }
  .grid.zero {
    stroke: var(--ink-muted);
  }
  .tick {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .line {
    fill: none;
    stroke-width: 2;
  }
  .dot {
    stroke: var(--paper);
    stroke-width: 2;
  }
  .raw .line {
    stroke: #c0621f;
  }
  .raw .dot {
    fill: #c0621f;
  }
  .scaled .line {
    stroke: var(--accent);
  }
  .scaled .dot {
    fill: var(--accent);
  }
  .direct-label {
    fill: var(--ink-secondary);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    font-size: 0.8rem;
    gap: 0.4rem 1.2rem;
  }
  .item {
    align-items: center;
    display: inline-flex;
    gap: 0.4rem;
  }
  .key {
    display: inline-block;
    height: 0;
    width: 1.2rem;
  }
  .key.raw {
    border-top: 3px solid #c0621f;
  }
  .key.scaled {
    border-top: 3px solid var(--accent);
  }
  .note {
    color: var(--ink-secondary);
    font-size: 0.8rem;
  }
  details {
    margin-top: 1rem;
  }
  summary {
    cursor: pointer;
    font-size: 0.85rem;
  }
  .table-scroll {
    overflow-x: auto;
  }
  table {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }
</style>
