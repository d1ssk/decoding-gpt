---
import training from '../../public/site/data/nanogpt/tiny-training.json';
import samples from '../../public/site/data/nanogpt/tiny-samples.json';
import { runUi } from '../lib/training';
import { linearScale, linePath, smooth, ticks } from '../lib/plot';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = runUi[lang];
const history = training.history;
const maxIters = training.config.max_iters;
const width = 600;
const height = 250;
const margin = { left: 40, right: 12, top: 12, bottom: 36 };
const x = linearScale([0, maxIters], [margin.left, width - margin.right]);
const y = linearScale([1.5, 4.5], [height - margin.bottom, margin.top]);
const batch = smooth(
  history.map((row) => row[2] as number),
  0.9,
);
const batchPath = linePath(
  batch.map((v, i) => [history[i][0], v] as [number, number]),
  x,
  y,
);
const trainPath = linePath(
  training.evals.map((e) => [e.iter, e.train] as [number, number]),
  x,
  y,
);
const valPath = linePath(
  training.evals.map((e) => [e.iter, e.val] as [number, number]),
  x,
  y,
);
const items = samples.samples.map((s) => ({
  iter: s.iter,
  text: s.text,
  train: s.train,
  val: s.val,
  batch: history[s.iter][2] as number,
}));
const initial = items.length - 1;
const describe = (item: (typeof items)[number]) =>
  item.train === null || item.val === null
    ? `${ui.noEval} ${ui.batchLoss}: ${item.batch.toFixed(3)}`
    : `train ${item.train.toFixed(4)} · val ${item.val.toFixed(4)}`;
---

<figure
  class="training-run"
  data-training-run
  data-items={JSON.stringify(
    items.map((i) => ({ ...i, label: describe(i), x: x(i.iter) })),
  )}
>
  <figcaption>{ui.caption}</figcaption>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={ui.caption}>
    {ticks(1.5, 4.5, 6).map((v) => (
      <>
        <path
          d={`M${margin.left} ${y(v)}H${width - margin.right}`}
          class="grid"
        />
        <text x={margin.left - 6} y={y(v) + 4} class="tick" text-anchor="end">
          {v}
        </text>
      </>
    ))}
    {ticks(0, maxIters, 4).map((v) => (
      <text
        x={x(v)}
        y={height - margin.bottom + 16}
        class="tick"
        text-anchor="middle"
      >
        {v}
      </text>
    ))}
    <text
      x={width - margin.right}
      y={height - 4}
      class="tick"
      text-anchor="end"
    >
      {ui.iteration}
    </text>
    {items.map((item) => (
      <path
        d={`M${x(item.iter)} ${margin.top}V${height - margin.bottom}`}
        class="snap"
      />
    ))}
    <path
      data-marker
      d={`M${x(items[initial].iter)} ${margin.top}V${height - margin.bottom}`}
      class="marker"
    />
    <path d={batchPath} class="batch" />
    <path d={trainPath} class="train" />
    <path d={valPath} class="val" />
    {training.evals.map((e) => (
      <circle cx={x(e.iter)} cy={y(e.val)} r="3" class="val-point" />
    ))}
    {training.evals.map((e) => (
      <circle cx={x(e.iter)} cy={y(e.train)} r="3" class="train-point" />
    ))}
  </svg>
  <p class="legend">
    <span class="item">
      <span class="key batch-key"></span>
      {ui.trainBatch}
    </span>
    <span class="item">
      <span class="key train-key"></span>
      {ui.trainEval}
    </span>
    <span class="item">
      <span class="key val-key"></span>
      {ui.valEval}
    </span>
  </p>
  <fieldset>
    <legend>{ui.snapshot}</legend>
    {items.map((item, i) => (
      <label>
        <input
          type="radio"
          name={`training-run-${lang}`}
          value={i}
          checked={i === initial}
          disabled
        />
        {item.iter.toLocaleString('en-US')}
      </label>
    ))}
  </fieldset>
  <p class="status" aria-live="polite" data-status>
    {describe(items[initial])}
  </p>
  <p class="label">{ui.sample}</p>
  <pre class="sample" data-sample tabindex="0">{items[initial].text}</pre>
  <p class="note">{ui.note}</p>
</figure>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-training-run]')
    .forEach((root) => {
      const items = JSON.parse(root.dataset.items!) as {
        iter: number;
        text: string;
        label: string;
        x: number;
      }[];
      const marker = root.querySelector('[data-marker]')!;
      root.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        input.disabled = false;
        input.addEventListener('change', () => {
          const item = items[Number(input.value)];
          root.querySelector('[data-sample]')!.textContent = item.text;
          root.querySelector('[data-status]')!.textContent = item.label;
          const d = marker.getAttribute('d')!.replace(/^M[\d.]+/, `M${item.x}`);
          marker.setAttribute('d', d);
        });
      });
    });
</script>

<style>
  .training-run {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  svg {
    display: block;
    height: auto;
    width: 100%;
  }
  .grid {
    stroke: var(--line);
    stroke-width: 0.7;
  }
  .tick {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .snap {
    stroke: var(--line);
    stroke-dasharray: 2 3;
  }
  .marker {
    stroke: var(--ink-secondary);
    stroke-width: 1.2;
  }
  .batch {
    fill: none;
    stroke: #276b92;
    stroke-opacity: 0.45;
    stroke-width: 1.2;
  }
  .train {
    fill: none;
    stroke: #276b92;
    stroke-width: 2;
  }
  .val {
    fill: none;
    stroke: #a05a20;
    stroke-width: 2;
  }
  .train-point {
    fill: #276b92;
  }
  .val-point {
    fill: #a05a20;
  }
  .legend {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.8rem;
    gap: 0.4rem 1.2rem;
  }
  .item {
    align-items: center;
    display: inline-flex;
    gap: 0.4rem;
  }
  .key {
    display: inline-block;
    height: 0;
    width: 1.4rem;
  }
  .batch-key {
    border-top: 2px solid rgba(39, 107, 146, 0.45);
  }
  .train-key {
    border-top: 3px solid #276b92;
  }
  .val-key {
    border-top: 3px solid #a05a20;
  }
  fieldset {
    border: 0;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.85rem;
    gap: 0.4rem 1rem;
    margin: 1rem 0 0.5rem;
    padding: 0;
  }
  legend {
    float: left;
    margin-right: 0.6rem;
  }
  label {
    align-items: center;
    display: inline-flex;
    font-family: var(--font-mono);
    gap: 0.2rem;
  }
  .status,
  .label,
  .note {
    font-size: 0.8rem;
  }
  .status {
    font-family: var(--font-mono);
  }
  .note {
    color: var(--ink-secondary);
  }
  .sample {
    margin: 0.5rem 0 1rem;
    max-height: 22rem;
    white-space: pre-wrap;
  }
</style>
