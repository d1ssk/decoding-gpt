---
import data from '../../public/site/data/nanogpt/scaling.json';
import { layerMarkers, scalingUi, widthColors } from '../lib/scaling';
import {
  formatCompact,
  linearScale,
  linePath,
  logScale,
  logTicks,
  ticks,
} from '../lib/plot';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = scalingUi[lang];
const runs = data.runs;
const byGroup = (group: string) => runs.filter((r) => r.group === group);
const width = 600;
const height = 280;
const margin = { left: 48, right: 70, top: 14, bottom: 40 };
const plotRight = width - margin.right;
const plotBottom = height - margin.bottom;
const tabs = ['size', 'length', 'context', 'overfit'] as const;

// Model size
const size = byGroup('model-size');
const sx = logScale([1e4, 1e7], [margin.left, plotRight]);
const sy = linearScale([1.5, 2.5], [plotBottom, margin.top]);
const widths = [...new Set(size.map((r) => r.nEmbd))];
const layers = [...new Set(size.map((r) => r.nLayer))].sort((a, b) => a - b);

// Training length
const length = byGroup('training-length');
const lx = logScale([1e5, 1e7], [margin.left, plotRight]);
const ly = linearScale([1.2, 2.6], [plotBottom, margin.top]);

// Context length
const context = byGroup('context-length');
const cx = logScale([1, 256], [margin.left, plotRight]);
const cy = linearScale([1.6, 3.0], [plotBottom, margin.top]);
// Mean loss over positions 0, 1, 2-3, 4-7, ... (power-of-two bins), plotted
// at the bin's geometric centre on a log axis of t + 1.
const contextBins = (values: number[]) => {
  const bins: [number, number][] = [];
  for (let start = 0; start < values.length; start = start ? start * 2 : 1) {
    const end = Math.min(start ? start * 2 : 1, values.length);
    const slice = values.slice(start, end);
    const mean = slice.reduce((a, b) => a + b, 0) / slice.length;
    bins.push([Math.sqrt((start + 1) * end), mean]);
  }
  return bins;
};
const contextColors = [
  '#c9a27a',
  '#a05a20',
  '#7a4d8c',
  '#276b92',
  '#3d6f6b',
  '#1e5b49',
];

// Overfitting
const overfit = byGroup('overfitting');
const ox = linearScale([0, 6000], [margin.left, plotRight]);
const oy = linearScale([1.2, 2.8], [plotBottom, margin.top]);
const overfitColors = ['#276b92', '#a05a20'];

const yTicks = (scale: typeof sy, min: number, max: number) =>
  ticks(min, max, 5).map((v) => ({ v, y: scale(v) }));
---

<figure class="scaling" data-scaling>
  <figcaption>{ui.caption}</figcaption>
  <fieldset>
    <legend>{ui.view}</legend>
    {tabs.map((tab, i) => (
      <label>
        <input
          type="radio"
          name={`scaling-${lang}`}
          value={tab}
          checked={i === 0}
          disabled
        />
        {ui.tabs[tab]}
      </label>
    ))}
  </fieldset>

  <div data-panel="size">
    <div class="size-legend">
      <p class="legend">
        <span class="legend-label">{ui.widthLegend}</span>
        {widths.map((w) => (
          <span class="item">
            <span
              class="key"
              style={`border-color: ${widthColors[w]}`}
              aria-hidden="true"
            />
            {w}
          </span>
        ))}
      </p>
      <p class="legend">
        <span class="legend-label">{ui.layerLegend}</span>
        {layers.map((layer) => (
          <span class="item">
            <svg class="marker-key" viewBox="-9 -9 18 18" aria-hidden="true">
              <path d={layerMarkers[layer]} fill="currentColor" />
            </svg>
            {layer}
          </span>
        ))}
      </p>
      <p class="legend">
        <span class="item">
          <svg class="marker-key" viewBox="-9 -9 18 18" aria-hidden="true">
            <path d={layerMarkers[1]} fill="currentColor" />
          </svg>
          {ui.valLoss}
        </span>
        <span class="item">
          <svg class="marker-key" viewBox="-9 -9 18 18" aria-hidden="true">
            <path
              d={layerMarkers[1]}
              fill="var(--paper)"
              stroke="currentColor"
              class="hollow"
            />
          </svg>
          {ui.trainLoss}
        </span>
      </p>
    </div>
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={ui.tabs.size}
    >
      <desc>{ui.sizeNote}</desc>
      {yTicks(sy, 1.5, 2.5).map(({ v, y }) => (
        <>
          <path d={`M${margin.left} ${y}H${plotRight}`} class="grid" />
          <text x={margin.left - 6} y={y + 4} class="tick" text-anchor="end">
            {v}
          </text>
        </>
      ))}
      {logTicks(1e4, 1e7).map((v) => (
        <>
          <path d={`M${sx(v)} ${margin.top}V${plotBottom}`} class="grid" />
          <text x={sx(v)} y={plotBottom + 16} class="tick" text-anchor="middle">
            {formatCompact(v)}
          </text>
        </>
      ))}
      <text x={plotRight} y={height - 6} class="tick" text-anchor="end">
        {ui.params}
      </text>
      {widths.map((w) => {
        const rows = size
          .filter((r) => r.nEmbd === w)
          .sort((a, b) => a.nLayer - b.nLayer);
        const color = widthColors[w];
        const last = rows[rows.length - 1];
        return (
          <g>
            <path
              d={linePath(
                rows.map(
                  (r) =>
                    [r.nonEmbeddingParameters, r.fixedVal] as [number, number],
                ),
                sx,
                sy,
              )}
              stroke={color}
              class="series"
            />
            {rows.map((r) => (
              <>
                <g
                  transform={`translate(${sx(r.nonEmbeddingParameters)} ${sy(r.fixedVal)})`}
                >
                  <path
                    d={layerMarkers[r.nLayer]}
                    fill={color}
                    class="model-point"
                  >
                    <title>{`n_layer=${r.nLayer}, n_embd=${r.nEmbd}: ${ui.valLoss} ${r.fixedVal}`}</title>
                  </path>
                </g>
                <g
                  transform={`translate(${sx(r.nonEmbeddingParameters)} ${sy(r.fixedTrain)})`}
                >
                  <path
                    d={layerMarkers[r.nLayer]}
                    fill="var(--paper)"
                    stroke={color}
                    class="model-point hollow"
                  >
                    <title>{`n_layer=${r.nLayer}, n_embd=${r.nEmbd}: ${ui.trainLoss} ${r.fixedTrain}`}</title>
                  </path>
                </g>
              </>
            ))}
            <text
              x={sx(last.nonEmbeddingParameters) + 8}
              y={sy(last.fixedVal) + 4}
              fill={color}
              class="series-label"
            >
              C={w}
            </text>
          </g>
        );
      })}
    </svg>
    <p class="note">{ui.sizeNote}</p>
  </div>

  <div data-panel="length">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={ui.tabs.length}
    >
      {yTicks(ly, 1.2, 2.6).map(({ v, y }) => (
        <>
          <path d={`M${margin.left} ${y}H${plotRight}`} class="grid" />
          <text x={margin.left - 6} y={y + 4} class="tick" text-anchor="end">
            {v}
          </text>
        </>
      ))}
      {logTicks(1e5, 1e7).map((v) => (
        <>
          <path d={`M${lx(v)} ${margin.top}V${plotBottom}`} class="grid" />
          <text x={lx(v)} y={plotBottom + 16} class="tick" text-anchor="middle">
            {formatCompact(v)}
          </text>
        </>
      ))}
      <text x={plotRight} y={height - 6} class="tick" text-anchor="end">
        {ui.tokens}
      </text>
      <path
        d={linePath(
          length.map((r) => [r.trainingTokens, r.fixedVal] as [number, number]),
          lx,
          ly,
        )}
        stroke="#a05a20"
        class="series"
      />
      <path
        d={linePath(
          length.map(
            (r) => [r.trainingTokens, r.fixedTrain] as [number, number],
          ),
          lx,
          ly,
        )}
        stroke="#276b92"
        class="series dashed"
      />
      {length.map((r) => (
        <>
          <circle
            cx={lx(r.trainingTokens)}
            cy={ly(r.fixedVal)}
            r="4"
            fill="#a05a20"
          >
            <title>{`max_iters=${r.maxIters}: val ${r.fixedVal}, train ${r.fixedTrain}`}</title>
          </circle>
          <circle
            cx={lx(r.trainingTokens)}
            cy={ly(r.fixedTrain)}
            r="3.5"
            fill="#276b92"
          />
          <text
            x={lx(r.trainingTokens)}
            y={ly(r.fixedVal) - 9}
            class="point-label"
            text-anchor="middle"
          >
            {r.maxIters}
          </text>
        </>
      ))}
      <text
        x={lx(length[length.length - 1].trainingTokens) + 8}
        y={ly(length[length.length - 1].fixedVal) + 4}
        class="series-label"
        fill="#a05a20"
      >
        val
      </text>
      <text
        x={lx(length[length.length - 1].trainingTokens) + 8}
        y={ly(length[length.length - 1].fixedTrain) + 4}
        class="series-label"
        fill="#276b92"
      >
        train
      </text>
    </svg>
    <p class="note">{ui.lengthNote}</p>
  </div>

  <div data-panel="context">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={ui.tabs.context}
    >
      {yTicks(cy, 1.6, 3.0).map(({ v, y }) => (
        <>
          <path d={`M${margin.left} ${y}H${plotRight}`} class="grid" />
          <text x={margin.left - 6} y={y + 4} class="tick" text-anchor="end">
            {v}
          </text>
        </>
      ))}
      {[1, 2, 4, 8, 16, 32, 64, 128, 256].map((v) => (
        <>
          <path d={`M${cx(v)} ${margin.top}V${plotBottom}`} class="grid" />
          <text x={cx(v)} y={plotBottom + 16} class="tick" text-anchor="middle">
            {v - 1}
          </text>
        </>
      ))}
      <text x={plotRight} y={height - 6} class="tick" text-anchor="end">
        {ui.position}
      </text>
      {context.map((r, i) => (
        <g>
          <path
            d={linePath(contextBins(r.valByPosition), cx, cy)}
            stroke={contextColors[i]}
            class="series"
          />
          {contextBins(r.valByPosition).map(([x, v]) => (
            <circle cx={cx(x)} cy={cy(v)} r="3" fill={contextColors[i]} />
          ))}
        </g>
      ))}
    </svg>
    <p class="legend">
      {context.map((r, i) => (
        <span class="item">
          <span class="key" style={`border-color: ${contextColors[i]}`} />T ={' '}
          {r.blockSize}
        </span>
      ))}
    </p>
    <p class="note">{ui.contextNote}</p>
  </div>

  <div data-panel="overfit">
    <svg
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-label={ui.tabs.overfit}
    >
      {yTicks(oy, 1.2, 2.8).map(({ v, y }) => (
        <>
          <path d={`M${margin.left} ${y}H${plotRight}`} class="grid" />
          <text x={margin.left - 6} y={y + 4} class="tick" text-anchor="end">
            {v}
          </text>
        </>
      ))}
      {ticks(0, 6000, 6).map((v) => (
        <text x={ox(v)} y={plotBottom + 16} class="tick" text-anchor="middle">
          {v}
        </text>
      ))}
      <text x={plotRight} y={height - 6} class="tick" text-anchor="end">
        {ui.iteration}
      </text>
      {overfit.map((r, i) => {
        const evals = r.evals.filter((e) => e[0] >= 500);
        return (
          <g>
            <path
              d={linePath(
                evals.map((e) => [e[0], e[1]] as [number, number]),
                ox,
                oy,
              )}
              stroke={overfitColors[i]}
              class="series dashed"
            />
            <path
              d={linePath(
                evals.map((e) => [e[0], e[2]] as [number, number]),
                ox,
                oy,
              )}
              stroke={overfitColors[i]}
              class="series"
            />
          </g>
        );
      })}
    </svg>
    <p class="legend">
      {overfit.map((r, i) => (
        <span class="item">
          <span class="key" style={`border-color: ${overfitColors[i]}`} />
          {ui.dropout} = {r.dropout}
        </span>
      ))}
    </p>
    <p class="note">{ui.overfitNote}</p>
  </div>

  <details>
    <summary>{ui.table}</summary>
    <div class="table-scroll" role="region" aria-label={ui.table} tabindex="0">
      <table>
        <thead>
          <tr>
            <th scope="col">{ui.group}</th>
            <th scope="col">L</th>
            <th scope="col">C</th>
            <th scope="col">T</th>
            <th scope="col">B</th>
            <th scope="col">max_iters</th>
            <th scope="col">dropout</th>
            <th scope="col">{ui.params}</th>
            <th scope="col">{ui.flops}</th>
            <th scope="col">{ui.trainLoss}</th>
            <th scope="col">{ui.valLoss}</th>
            <th scope="col">{ui.seconds}</th>
          </tr>
        </thead>
        <tbody>
          {runs.map((r) => (
            <tr>
              <td>
                {
                  ui.tabs[
                    (
                      {
                        'model-size': 'size',
                        'training-length': 'length',
                        'context-length': 'context',
                        overfitting: 'overfit',
                      } as const
                    )[r.group as 'model-size']
                  ]
                }
              </td>
              <td>{r.nLayer}</td>
              <td>{r.nEmbd}</td>
              <td>{r.blockSize}</td>
              <td>{r.batchSize}</td>
              <td>{r.maxIters}</td>
              <td>{r.dropout}</td>
              <td>{r.nonEmbeddingParameters.toLocaleString('en-US')}</td>
              <td>{r.estimatedFlops.toExponential(2)}</td>
              <td>{r.fixedTrain.toFixed(3)}</td>
              <td>{r.fixedVal.toFixed(3)}</td>
              <td>{r.seconds}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
  <p class="note">{ui.note}</p>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-scaling]').forEach((root) => {
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    const show = (name: string) =>
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== name;
      });
    root
      .querySelectorAll<HTMLInputElement>('input[type="radio"]')
      .forEach((input) => {
        input.disabled = false;
        input.addEventListener('change', () => show(input.value));
      });
    show('size');
  });
</script>

<style>
  .scaling {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  fieldset {
    border: 0;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.85rem;
    gap: 0.4rem 1.1rem;
    margin: 0 0 1rem;
    padding: 0;
  }
  legend {
    float: left;
    margin-right: 0.6rem;
  }
  label {
    align-items: center;
    display: inline-flex;
    gap: 0.25rem;
  }
  [hidden] {
    display: none;
  }
  svg {
    display: block;
    height: auto;
    width: 100%;
  }
  .grid {
    stroke: var(--line);
    stroke-width: 0.7;
  }
  .tick,
  .point-label {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .series {
    fill: none;
    stroke-width: 2;
  }
  .series.thin {
    stroke-width: 1.5;
  }
  .series.dashed {
    stroke-dasharray: 5 4;
  }
  .hollow {
    stroke-width: 1.5;
  }
  .series-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
  }
  .note {
    color: var(--ink-secondary);
    font-size: 0.8rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    gap: 0.3rem 1.2rem;
  }
  .item {
    align-items: center;
    display: inline-flex;
    gap: 0.35rem;
  }
  .size-legend {
    margin-bottom: 0.75rem;
  }
  .size-legend .legend {
    align-items: center;
    font-size: 0.8rem;
    margin: 0.35rem 0;
    gap: 0.3rem 1rem;
  }
  .legend-label {
    font-weight: 600;
  }
  .marker-key {
    width: 18px;
    height: 18px;
    flex: none;
  }
  @media (max-width: 480px) {
    .model-point {
      transform: scale(1.3);
    }
  }
  .key {
    border-top: 3px solid;
    display: inline-block;
    width: 1.4rem;
  }
  details {
    margin-top: 1rem;
  }
  summary {
    cursor: pointer;
    font-size: 0.85rem;
  }
  .table-scroll {
    overflow-x: auto;
  }
  table {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    white-space: nowrap;
  }
</style>
