---
import EmbeddingVectorPlot from './EmbeddingVectorPlot.astro';
import example from '../../public/site/data/nanogpt/embeddings.json';
import { embeddingUi } from '../lib/embedding-i18n';
import { embeddingColor, formatEmbedding } from '../lib/embeddings';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = embeddingUi[lang];
const selectedB = 0;
const selectedT = 2;
const selectedId = example.input[selectedB][selectedT];
const dimensions = Array.from({ length: example.config.n_embd }, (_, c) => c);
const extent =
  Math.ceil(
    Math.max(
      ...example.tokenWeights.flat().map(Math.abs),
      ...example.positionWeights.flat().map(Math.abs),
      ...example.tokenWeights.flatMap((token) =>
        example.positionWeights.flatMap((position) =>
          token.map((value, c) => Math.abs(value + position[c])),
        ),
      ),
    ) / 0.02,
  ) * 0.02;
const character = (id: number) => example.vocabulary[id].replace('\n', '\\n');
const vectors = [
  example.tokenWeights[selectedId],
  example.positionWeights[selectedT],
  example.combined[selectedB][selectedT],
];
---

<figure
  class="embedding-inspector"
  data-embedding-inspector
  data-example={JSON.stringify(example)}
>
  <figcaption>{t.caption}</figcaption>
  <div class="controls">
    <span>{t.length}: 6</span>
    <label>
      {t.token}
      <select data-token disabled>
        {example.vocabulary.map((_, id) => (
          <option value={id} selected={id === selectedId}>
            {id}: {character(id)}
          </option>
        ))}
      </select>
    </label>
    <button type="button" data-reset disabled>
      {t.reset}
    </button>
  </div>
  <div class="table-scroll" role="region" aria-label={t.input} tabindex="0">
    <table>
      <caption>{t.input}</caption>
      <thead>
        <tr>
          <th scope="col">b \ t</th>
          {example.input[0].map((_, pos) => (
            <th scope="col" data-column={pos}>
              {pos}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {example.input.map((row, b) => (
          <tr>
            <th scope="row">{b}</th>
            {row.map((id, pos) => (
              <td data-column={pos}>
                <button
                  type="button"
                  data-input
                  data-b={b}
                  data-t={pos}
                  aria-pressed={b === selectedB && pos === selectedT}
                  aria-label={`b = ${b}, t = ${pos}, ID = ${id}: ${character(id)}`}
                  disabled
                >
                  <span data-id>{id}</span>
                  <small data-character>{character(id)}</small>
                </button>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p data-selection role="status" aria-atomic="true">
    b = 0, t = 2, ID = 3 (l)
  </p>
  <EmbeddingVectorPlot
    lang={lang}
    token={vectors[0]}
    position={vectors[1]}
    extent={extent}
  />
  <p data-shapes>tok_emb [2, 6, 3] + pos_emb [6, 3] → x [2, 6, 3]</p>
  <div class="table-scroll" role="region" aria-label={t.addition} tabindex="0">
    <table>
      <caption>{t.addition}</caption>
      <thead>
        <tr>
          <th scope="col">c</th>
          {dimensions.map((c) => (
            <th scope="col">{c}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {[t.tokenRow, t.positionRow, t.sumRow].map((label, row) => (
          <tr>
            <th scope="row">
              {row === 1 ? '+ ' : row === 2 ? '= ' : ''}
              {label}
            </th>
            {vectors[row].map((value, c) => (
              <td
                data-vector={row}
                data-c={c}
                style={{ backgroundColor: embeddingColor(value) }}
              >
                {formatEmbedding(value)}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <details>
    <summary>{t.weightsDetails}</summary>
    <div class="weights">
      {(
        [
          ['token', t.tokenWeights, example.tokenWeights],
          ['position', t.positionWeights, example.positionWeights],
        ] as const
      ).map(([kind, caption, weights]) => (
        <div
          class="table-scroll"
          role="region"
          aria-label={caption}
          tabindex="0"
        >
          <table data-weights={kind}>
            <caption>{caption}</caption>
            <thead>
              <tr>
                <th scope="col">{kind === 'token' ? 'ID' : 't'} \ c</th>
                {dimensions.map((c) => (
                  <th scope="col">{c}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {weights.map((row, index) => (
                <tr
                  data-weight-row={index}
                  class:list={{
                    chosen:
                      index === (kind === 'token' ? selectedId : selectedT),
                    unused: kind === 'position' && index >= 6,
                  }}
                >
                  <th scope="row">
                    {index}
                    {kind === 'token' && <small>{character(index)}</small>}
                  </th>
                  {row.map((value) => (
                    <td style={{ backgroundColor: embeddingColor(value) }}>
                      {formatEmbedding(value)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </div>
  </details>
  <p class="note">{t.note}</p>
  <noscript>
    <p>{t.noScript}</p>
  </noscript>
</figure>

<script>
  import { mountVectorPlot } from '../lib/embedding-plot';
  import type savedExample from '../../public/site/data/nanogpt/embeddings.json';
  import { embeddingColor, formatEmbedding } from '../lib/embeddings';

  document
    .querySelectorAll<HTMLElement>('[data-embedding-inspector]')
    .forEach((root) => {
      const example: typeof savedExample = JSON.parse(root.dataset.example!);
      const updatePlot = mountVectorPlot(
        root.querySelector<HTMLElement>('[data-vector-plot]')!,
      );
      let inputs = example.input.map((row) => [...row]);
      let b = 0;
      let pos = 2;
      const token = root.querySelector<HTMLSelectElement>('[data-token]')!;
      const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
      const character = (id: number) =>
        example.vocabulary[id].replace('\n', '\\n');

      function update() {
        const id = inputs[b][pos];
        token.value = String(id);
        root.querySelector('[data-selection]')!.textContent =
          `b = ${b}, t = ${pos}, ID = ${id} (${character(id)})`;
        root
          .querySelectorAll<HTMLButtonElement>('[data-input]')
          .forEach((button) => {
            const row = Number(button.dataset.b);
            const column = Number(button.dataset.t);
            const value = inputs[row][column];
            button.setAttribute(
              'aria-pressed',
              String(row === b && column === pos),
            );
            button.setAttribute(
              'aria-label',
              `b = ${row}, t = ${column}, ID = ${value}: ${character(value)}`,
            );
            button.querySelector('[data-id]')!.textContent = String(value);
            button.querySelector('[data-character]')!.textContent =
              character(value);
          });
        root
          .querySelectorAll<HTMLElement>('[data-weights]')
          .forEach((table) => {
            const isPosition = table.dataset.weights === 'position';
            table
              .querySelectorAll<HTMLElement>('[data-weight-row]')
              .forEach((row) => {
                const index = Number(row.dataset.weightRow);
                row.classList.toggle(
                  'chosen',
                  index === (isPosition ? pos : id),
                );
              });
          });
        const tokenVector = example.tokenWeights[id];
        const positionVector = example.positionWeights[pos];
        // Match PyTorch float32 addition before rounding for display.
        const sum = tokenVector.map((value, c) =>
          Math.fround(value + positionVector[c]),
        );
        const vectors = [tokenVector, positionVector, sum];
        updatePlot(tokenVector, positionVector);
        root.querySelectorAll<HTMLElement>('[data-vector]').forEach((cell) => {
          const value =
            vectors[Number(cell.dataset.vector)][Number(cell.dataset.c)];
          cell.textContent = formatEmbedding(value);
          cell.style.backgroundColor = embeddingColor(value);
        });
      }

      root
        .querySelectorAll<HTMLButtonElement>('[data-input]')
        .forEach((button) => {
          button.disabled = false;
          button.addEventListener('click', () => {
            b = Number(button.dataset.b);
            pos = Number(button.dataset.t);
            update();
          });
        });
      token.disabled = reset.disabled = false;
      token.addEventListener('change', () => {
        inputs[b][pos] = Number(token.value);
        update();
      });
      reset.addEventListener('click', () => {
        inputs = example.input.map((row) => [...row]);
        b = 0;
        pos = 2;
        update();
      });
    });
</script>

<style>
  .embedding-inspector {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
  }
  .embedding-inspector p,
  label,
  button,
  select {
    font-size: 0.85rem;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 1rem;
  }
  label,
  input,
  select {
    display: block;
  }
  input {
    accent-color: var(--accent);
    max-width: 100%;
  }
  button,
  select {
    font-family: inherit;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 0.15rem;
    padding: 0.4rem 0.6rem;
  }
  button {
    cursor: pointer;
  }
  button:disabled {
    cursor: default;
  }
  [data-reset]:disabled,
  select:disabled {
    opacity: 0.6;
  }
  input:focus-visible,
  select:focus-visible,
  .table-scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  [aria-pressed='true'] {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    background: var(--accent-light);
  }
  .table-scroll {
    overflow-x: auto;
    min-width: 0;
  }
  summary {
    cursor: pointer;
    font-size: 0.85rem;
    padding: 0.75rem 0;
  }
  .weights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .embedding-inspector table {
    width: 100%;
    margin: 1rem 0;
    font-size: 0.8rem;
  }
  caption {
    text-align: left;
    margin-bottom: 0.5rem;
  }
  .embedding-inspector th,
  .embedding-inspector td {
    padding: 0.35rem;
    text-align: center;
    white-space: nowrap;
  }
  td,
  [data-selection],
  [data-shapes] {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  [data-shapes] {
    overflow-wrap: anywhere;
  }
  small {
    display: block;
    font-weight: normal;
  }
  [data-input] {
    min-width: 2.75rem;
    min-height: 2.75rem;
    width: 100%;
  }
  .chosen {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .unused {
    color: var(--ink-muted);
  }
  .unused td {
    background: var(--paper-subtle) !important;
  }
  .note {
    color: var(--ink-muted);
  }
  @media (max-width: 800px) {
    .weights {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
