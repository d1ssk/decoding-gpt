---
import data from '../../public/site/data/nanogpt/batch-coverage.json';
import { coverageUi } from '../lib/corpus';
import { linearScale, linePath, ticks } from '../lib/plot';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = coverageUi[lang];
const positions = data.coverageCounts.reduce((a, b) => a + b, 0);
const rows = data.coverageCounts.map((count, k) => ({
  k,
  share: count / positions,
  count,
  expected: data.poissonCounts[k],
  expectedShare: data.poissonCounts[k] / positions,
}));
const pct = (share: number) => `${(share * 100).toFixed(1)}%`;

const width = 640;
const height = 230;
const margin = { left: 44, right: 12, top: 14, bottom: 36 };
const band = (width - margin.left - margin.right) / rows.length;
const yMax = 0.35;
const y = linearScale([0, yMax], [height - margin.bottom, margin.top]);

const progress = [[0, 0], ...data.coveredFractionByUpdate] as [
  number,
  number,
][];
const pWidth = 640;
const pHeight = 180;
const pMargin = { left: 44, right: 24, top: 12, bottom: 36 };
const px = linearScale(
  [0, data.config.updates],
  [pMargin.left, pWidth - pMargin.right],
);
const py = linearScale([0, 1], [pHeight - pMargin.bottom, pMargin.top]);
const last = progress[progress.length - 1];
---

<figure class="batch-coverage">
  <figcaption>{ui.caption}</figcaption>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={ui.caption}>
    {ticks(0, yMax, 4).map((v) => (
      <>
        <path
          d={`M${margin.left} ${y(v)}H${width - margin.right}`}
          class:list={['grid', { zero: v === 0 }]}
        />
        <text x={margin.left - 6} y={y(v) + 4} class="tick" text-anchor="end">
          {Math.round(v * 100)}%
        </text>
      </>
    ))}
    {rows.map((row) => {
      const cx = margin.left + band * (row.k + 0.5);
      const top = y(row.share);
      return (
        <g class="bar">
          <title>
            {`${row.k}: ${row.count.toLocaleString('en-US')} (${pct(row.share)}) · ${ui.expected} ${pct(row.expectedShare)}`}
          </title>
          <rect
            x={cx - band / 2}
            y={margin.top}
            width={band}
            height={y(0) - margin.top}
            class="hit"
          />
          <rect
            x={cx - band * 0.32}
            y={top}
            width={band * 0.64}
            height={Math.max(y(0) - top, 0.5)}
            class="observed"
          />
          <path
            d={`M${cx - band * 0.4} ${y(row.expectedShare)}H${cx + band * 0.4}`}
            class="expected"
          />
          <text
            x={cx}
            y={height - margin.bottom + 15}
            class="tick"
            text-anchor="middle"
          >
            {row.k}
          </text>
          {row.k <= 2 && (
            <text x={cx} y={top - 6} class="value-label" text-anchor="middle">
              {pct(row.share)}
            </text>
          )}
        </g>
      );
    })}
    <text
      x={width - margin.right}
      y={height - 4}
      class="tick"
      text-anchor="end"
    >
      {ui.countAxis}
    </text>
  </svg>
  <p class="legend">
    <span class="item">
      <span class="key observed-key"></span>
      {ui.observed}
    </span>
    <span class="item">
      <span class="key expected-key"></span>
      {ui.poisson}
    </span>
  </p>

  <p class="subcaption">{ui.progressCaption}</p>
  <svg
    viewBox={`0 0 ${pWidth} ${pHeight}`}
    role="img"
    aria-label={ui.progressCaption}
  >
    {[0, 0.25, 0.5, 0.75, 1].map((v) => (
      <>
        <path
          d={`M${pMargin.left} ${py(v)}H${pWidth - pMargin.right}`}
          class="grid"
        />
        <text x={pMargin.left - 6} y={py(v) + 4} class="tick" text-anchor="end">
          {Math.round(v * 100)}%
        </text>
      </>
    ))}
    {[0, 500, 1000, 1500, 2000].map((v) => (
      <text
        x={px(v)}
        y={pHeight - pMargin.bottom + 15}
        class="tick"
        text-anchor="middle"
      >
        {v.toLocaleString('en-US')}
      </text>
    ))}
    <path d={linePath(progress, px, py)} class="progress" />
    {progress.slice(1).map(([u, f]) => (
      <circle cx={px(u)} cy={py(f)} r="4" class="progress-dot">
        <title>{`${u.toLocaleString('en-US')}: ${pct(f)}`}</title>
      </circle>
    ))}
    <text
      x={px(last[0]) - 8}
      y={py(last[1]) + 18}
      class="value-label"
      text-anchor="end"
    >
      {pct(last[1])}
    </text>
    <text
      x={pWidth - pMargin.right}
      y={pHeight - 4}
      class="tick"
      text-anchor="end"
    >
      {ui.updates}
    </text>
  </svg>
  <p class="note">{ui.note}</p>

  <details>
    <summary>{ui.table}</summary>
    <table>
      <thead>
        <tr>
          <th scope="col">{ui.times}</th>
          <th scope="col">{ui.positions}</th>
          <th scope="col">{ui.shareAxis}</th>
          <th scope="col">{ui.expected}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>{row.k}</td>
            <td>{row.count.toLocaleString('en-US')}</td>
            <td>{pct(row.share)}</td>
            <td>{pct(row.expectedShare)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>

<style>
  .batch-coverage {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption,
  .subcaption {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .subcaption {
    margin-top: 1.75rem;
  }
  svg {
    display: block;
    height: auto;
    width: 100%;
  }
  .grid {
    stroke: var(--line);
    stroke-width: 0.7;
  }
  .grid.zero {
    stroke: var(--ink-muted);
  }
  .tick {
    fill: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .hit {
    fill: transparent;
  }
  .observed {
    fill: var(--accent);
  }
  .bar:hover .observed {
    fill: #2f6fb0;
  }
  .expected {
    stroke: var(--ink);
    stroke-width: 2;
  }
  .value-label {
    fill: var(--ink-secondary);
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .progress {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
  }
  .progress-dot {
    fill: var(--accent);
    stroke: var(--paper);
    stroke-width: 2;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    font-size: 0.8rem;
    gap: 0.4rem 1.2rem;
  }
  .item {
    align-items: center;
    display: inline-flex;
    gap: 0.4rem;
  }
  .key {
    display: inline-block;
    height: 0.7rem;
    width: 1rem;
  }
  .observed-key {
    background: var(--accent);
  }
  .expected-key {
    border-top: 2px solid var(--ink);
    height: 0;
  }
  .note {
    color: var(--ink-secondary);
    font-size: 0.8rem;
  }
  details {
    margin-top: 1rem;
  }
  summary {
    cursor: pointer;
    font-size: 0.85rem;
  }
  table {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
