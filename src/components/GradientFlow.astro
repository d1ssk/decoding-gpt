---
import data from '../../public/site/data/nanogpt/backpropagation.json';
import { backpropUi } from '../lib/backprop';
import { charLabel } from '../lib/plot';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = backpropUi[lang];
const voc = data.vocabulary;
const chars = [...data.text];
const rows = data.embeddingGradientNorms;
const initial = 61;
const shade = (t: number) => {
  const row = rows[t];
  const max = Math.max(...row);
  return chars.map((_, j) => (j < row.length ? row[j] / max : 0));
};
const initialShade = shade(initial);
const largest = (t: number) =>
  rows[t]
    .map((v, j) => [v, j] as const)
    .sort((a, b) => b[0] - a[0])
    .slice(0, 4)
    .map(([v, j]) => `${j}:${charLabel(chars[j])} ${v.toFixed(3)}`)
    .join(' · ');
const payload = JSON.stringify({
  rows,
  text: data.text,
  targets: data.targets,
  vocabulary: voc,
});
---

<figure
  class="gradient-flow"
  data-gradient-flow
  data-payload={payload}
  data-initial={initial}
>
  <figcaption>{ui.flowCaption}</figcaption>
  <p class="note" id={`gradient-flow-note-${lang}`}>
    {ui.flowNote}
  </p>
  <div
    class="text"
    role="group"
    aria-describedby={`gradient-flow-note-${lang}`}
  >
    {chars.map((char, t) => (
      <Fragment>
        <button
          type="button"
          data-position={t}
          aria-pressed={t === initial}
          aria-label={`${ui.position} ${t}: ${charLabel(char)}`}
          class:list={{ newline: char === '\n', future: t > initial }}
          style={`--g: ${initialShade[t]}`}
          disabled
        >
          {charLabel(char)}
        </button>
        {char === '\n' && <br />}
      </Fragment>
    ))}
  </div>
  <dl class="readout" aria-live="polite">
    <div>
      <dt>{ui.lossAt}</dt>
      <dd data-readout="loss">
        ℓ<sub>{initial}</sub>: {charLabel(chars[initial])} →{' '}
        {charLabel(voc[data.targets[initial]])}
      </dd>
    </div>
    <div>
      <dt>{ui.largest}</dt>
      <dd data-readout="largest">{largest(initial)}</dd>
    </div>
    <div>
      <dt>{ui.future}</dt>
      <dd>{ui.zero}</dd>
    </div>
  </dl>
  <noscript>
    <p class="note">{ui.noScript}</p>
  </noscript>
</figure>

<script>
  import { charLabel } from '../lib/plot';

  document
    .querySelectorAll<HTMLElement>('[data-gradient-flow]')
    .forEach((root) => {
      const data = JSON.parse(root.dataset.payload!) as {
        rows: number[][];
        text: string;
        targets: number[];
        vocabulary: string[];
      };
      const chars = [...data.text];
      const buttons =
        root.querySelectorAll<HTMLButtonElement>('[data-position]');
      const select = (t: number) => {
        const row = data.rows[t];
        const max = Math.max(...row);
        buttons.forEach((button, j) => {
          button.style.setProperty(
            '--g',
            String(j < row.length ? row[j] / max : 0),
          );
          button.classList.toggle('future', j > t);
          button.setAttribute('aria-pressed', String(j === t));
        });
        const loss = root.querySelector('[data-readout="loss"]')!;
        loss.innerHTML = '';
        loss.append('ℓ');
        const sub = document.createElement('sub');
        sub.textContent = String(t);
        loss.append(
          sub,
          `: ${charLabel(chars[t])} → ${charLabel(data.vocabulary[data.targets[t]])}`,
        );
        root.querySelector('[data-readout="largest"]')!.textContent = row
          .map((v, j) => [v, j] as const)
          .sort((a, b) => b[0] - a[0])
          .slice(0, 4)
          .map(([v, j]) => `${j}:${charLabel(chars[j])} ${v.toFixed(3)}`)
          .join(' · ');
      };
      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener('click', () =>
          select(Number(button.dataset.position)),
        );
      });
    });
</script>

<style>
  .gradient-flow {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .note {
    color: var(--ink-secondary);
    font-size: 0.8rem;
  }
  .text {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.9;
    margin: 0.75rem 0;
  }
  .text button {
    background: rgba(160, 90, 32, calc(var(--g) * 0.8));
    border: 1px solid transparent;
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    margin: 0;
    min-width: 1.05em;
    padding: 0 0.08em;
  }
  .text button.future {
    color: var(--ink-muted);
    text-decoration: line-through;
    text-decoration-color: var(--line-strong);
  }
  .text button:disabled {
    cursor: default;
  }
  .text button.newline {
    font-size: 0.75em;
  }
  .text button[aria-pressed='true'] {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .readout {
    display: grid;
    font-size: 0.8rem;
    gap: 0.25rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin: 1rem 0;
  }
  .readout dt {
    color: var(--ink-muted);
  }
  .readout dd {
    font-family: var(--font-mono);
    margin: 0;
  }
</style>
