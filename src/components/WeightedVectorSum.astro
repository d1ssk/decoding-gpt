---
import VectorArrow from './VectorArrow.astro';
import VectorGrid from './VectorGrid.astro';
import {
  exampleInputs,
  exampleValues,
  exampleAttention,
  exampleValueWeights,
  weightedVectors,
  vectorColors,
  resultColor,
  vectorExampleUi,
  subscript,
  formatVector,
  formatWeight,
} from '../lib/weighted-vectors';
import type { Language } from '../lib/site';
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = vectorExampleUi[lang];
const prefix = `weighted-vectors-${lang}`;
const selectedB = 0;
const selectedT = 2;
const vectors = exampleValues[selectedB];
const weights = exampleAttention[selectedB][selectedT];
const initial = weightedVectors(weights, vectors);
const colors = [...vectorColors, resultColor];
---

<figure class="weighted-vectors" data-weighted-vectors data-lang={lang}>
  <figcaption>{ui.caption}</figcaption>
  <p id={`${prefix}-instruction`} class="instruction">
    {ui.instruction}
  </p>
  <VectorGrid kind="x" {lang} {prefix} {selectedB} {selectedT} />
  <p class="diagram-hint">{ui.transform}</p>
  <VectorGrid kind="v" {lang} {prefix} {selectedB} {selectedT} />

  <div class="attention-slice" data-stage="att">
    <table>
      <caption>
        {ui.attention}
        <code data-att-slice>att[0, 0] [3, 3]</code>
      </caption>
      <thead>
        <tr>
          <th scope="col">t \ j</th>
          {[0, 1, 2].map((j) => (
            <th scope="col">{j}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {exampleAttention[selectedB].map((row, position) => (
          <tr
            data-att-row={position}
            class:list={{ 'selected-att': position === selectedT }}
          >
            <th scope="row">{position}</th>
            {row.map((weight, j) => (
              <td data-att-cell data-t={position} data-j={j}>
                {formatWeight(weight)}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="diagram-hint">{ui.attentionHint}</p>
  </div>

  <div data-stage="calculation">
    <p class="calculation-title">{ui.calculation}</p>
    <p class="selection" role="status" aria-atomic="true">
      <code data-selection>x[0, 2, :] → y[0, 0, 2, :]</code>
    </p>
    <div class="vector-equation" role="group" aria-label={ui.equation}>
      {[...vectors, initial.result].map((vector, j) => (
        <div class="vector-term" data-term={j}>
          <span class="operator" aria-hidden="true">
            {j === 0 ? '' : j === 3 ? '=' : '+'}
          </span>
          <span class="coefficient" data-coefficient={j < 3 ? j : undefined}>
            {j < 3 ? `${formatWeight(weights[j])} ×` : ''}
          </span>
          <VectorArrow
            id={`${prefix}-equation-${j}`}
            vector={vector}
            color={colors[j]}
            name={j < 3 ? `v${subscript(j)}` : `y${subscript(selectedT)}`}
            label={
              j < 3
                ? `${ui.source}: j = ${j}`
                : `${ui.result}: t = ${selectedT}`
            }
          />
        </div>
      ))}
    </div>
    <details>
      <summary>{ui.components}</summary>
      <p>
        <code data-selected-input>
          x[0, 2, :] = {formatVector(exampleInputs[0][2])}
        </code>
      </p>
      <div
        class="component-scroll"
        role="region"
        aria-label={ui.components}
        tabindex="0"
      >
        <table>
          <thead>
            <tr>
              <th scope="col">j</th>
              <th scope="col">{ui.vector}</th>
              <th scope="col">{ui.coefficient}</th>
              <th scope="col">{ui.contribution}</th>
            </tr>
          </thead>
          <tbody>
            {vectors.map((vector, j) => (
              <tr>
                <th scope="row">{j}</th>
                <td data-vector-components={j}>{formatVector(vector)}</td>
                <td data-number-weight={j}>{formatWeight(weights[j])}</td>
                <td data-contribution={j}>
                  {formatVector(initial.contributions[j])}
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row" colspan="3">
                {ui.sum} <span data-result-name>y₂</span>
              </th>
              <td data-result-components>{formatVector(initial.result)}</td>
            </tr>
          </tfoot>
        </table>
        <table>
          <caption>{ui.valueWeights}</caption>
          <thead>
            <tr>
              <th scope="col">r \ c</th>
              <th scope="col">0</th>
              <th scope="col">1</th>
            </tr>
          </thead>
          <tbody>
            {exampleValueWeights.map((row, r) => (
              <tr>
                <th scope="row">{r}</th>
                {row.map((value) => (
                  <td>{value}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  </div>
  <VectorGrid kind="y" {lang} {prefix} {selectedB} {selectedT} />
  <noscript>
    <p>{ui.noScript}</p>
  </noscript>
</figure>

<script>
  import {
    exampleInputs,
    exampleValues,
    exampleAttention,
    weightedVectors,
    subscript,
    formatVector,
    formatWeight,
    vectorPoint,
    vectorExampleUi,
  } from '../lib/weighted-vectors';
  document
    .querySelectorAll<HTMLElement>('[data-weighted-vectors]')
    .forEach((root) => {
      const ui = vectorExampleUi[root.dataset.lang === 'ja' ? 'ja' : 'en'];
      const setText = (selector: string, value: string) => {
        root.querySelectorAll(selector).forEach((element) => {
          element.textContent = value;
        });
      };
      function update(b: number, position: number) {
        const weights = exampleAttention[b][position];
        const vectors = exampleValues[b];
        const { contributions, result } = weightedVectors(weights, vectors);
        const name = `y${subscript(position)}`;
        setText('[data-att-slice]', `att[${b}, 0] [3, 3]`);
        setText(
          '[data-selection]',
          `x[${b}, ${position}, :] → y[${b}, 0, ${position}, :]`,
        );
        setText(
          '[data-selected-input]',
          `x[${b}, ${position}, :] = ${formatVector(exampleInputs[b][position])}`,
        );
        root
          .querySelectorAll<HTMLButtonElement>('[data-input]')
          .forEach((button) => {
            button.setAttribute(
              'aria-pressed',
              String(
                Number(button.dataset.b) === b &&
                  Number(button.dataset.t) === position,
              ),
            );
          });
        root
          .querySelectorAll<HTMLElement>('[data-vector-cell]')
          .forEach((cell) => {
            const active = Number(cell.dataset.b) === b;
            const isValue = cell.dataset.kind === 'v';
            cell.classList.toggle('selected-source', isValue && active);
            cell.classList.toggle(
              'selected-position',
              cell.dataset.kind !== 'x' &&
                active &&
                Number(cell.dataset.t) === position,
            );
            cell.classList.toggle(
              'dimmed',
              isValue && active && weights[Number(cell.dataset.t)] === 0,
            );
          });
        root.querySelectorAll<HTMLElement>('[data-att-row]').forEach((row) => {
          row.classList.toggle(
            'selected-att',
            Number(row.dataset.attRow) === position,
          );
        });
        root
          .querySelectorAll<HTMLElement>('[data-att-cell]')
          .forEach((cell) => {
            cell.textContent = formatWeight(
              exampleAttention[b][Number(cell.dataset.t)][
                Number(cell.dataset.j)
              ],
            );
          });
        [...vectors, result].forEach((vector, j) => {
          const term = root.querySelector(`[data-term="${j}"]`)!;
          const end = vectorPoint(vector);
          const line = term.querySelector('[data-vector-line]')!;
          line.setAttribute('x2', String(end.x));
          line.setAttribute('y2', String(end.y));
          if (j < 3) {
            const weight = weights[j];
            term.classList.toggle('dimmed', weight === 0);
            setText(`[data-coefficient="${j}"]`, `${formatWeight(weight)} ×`);
            setText(`[data-number-weight="${j}"]`, formatWeight(weight));
            setText(`[data-vector-components="${j}"]`, formatVector(vector));
            setText(
              `[data-contribution="${j}"]`,
              formatVector(contributions[j]),
            );
          } else {
            term.querySelector('[data-vector-name]')!.textContent = name;
            term
              .querySelector('svg')!
              .setAttribute('aria-label', `${ui.result}: t = ${position}`);
          }
        });
        setText('[data-result-name]', name);
        setText('[data-result-components]', formatVector(result));
      }
      root
        .querySelectorAll<HTMLButtonElement>('[data-input]')
        .forEach((button) => {
          button.disabled = false;
          button.addEventListener('click', () =>
            update(Number(button.dataset.b), Number(button.dataset.t)),
          );
        });
    });
</script>

<style>
  .weighted-vectors {
    margin: 2rem 0;
    padding: 1.25rem 0;
    border-block: 1px solid var(--line-strong);
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .weighted-vectors .instruction {
    font-size: 0.9rem;
  }
  caption {
    text-align: left;
    font-size: 0.85rem;
    padding-bottom: 0.5rem;
  }
  .attention-slice {
    margin: 1.5rem 0;
  }
  .attention-slice table {
    width: 100%;
    max-width: 34rem;
    margin: 0;
  }
  .attention-slice :is(td, th) {
    text-align: center;
    padding: 0.4rem 0.6rem;
  }
  .attention-slice th {
    color: var(--ink-muted);
    font-size: 0.65rem;
    font-weight: 400;
    white-space: nowrap;
  }
  .attention-slice td {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 500;
  }
  .attention-slice th:first-child {
    width: 2.5rem;
    padding-inline: 0.25rem;
  }
  .selected-att {
    background: var(--accent-light);
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .calculation-title {
    font-size: 0.9rem;
    font-weight: 600;
  }
  .weighted-vectors .selection {
    font-size: 0.85rem;
    margin-block: 0.5rem;
    overflow-wrap: anywhere;
  }
  .vector-equation {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.3rem;
    margin-top: 1rem;
  }
  .vector-term {
    display: grid;
    grid-template-columns: 0.9rem 2.8rem minmax(0, 1fr);
    align-items: center;
  }
  .operator {
    font-size: 1.1rem;
  }
  .coefficient {
    font-size: 0.8rem;
    white-space: nowrap;
    text-align: center;
  }
  .dimmed {
    opacity: 0.3;
  }
  .weighted-vectors .diagram-hint {
    font-size: 0.8rem;
    color: var(--ink-secondary);
    margin: 0.5rem 0 1.25rem;
  }
  summary {
    cursor: pointer;
    font-size: 0.85rem;
  }
  .component-scroll {
    overflow-x: auto;
  }
  .component-scroll table {
    font-size: 0.8rem;
  }
  td {
    font-family: var(--font-mono);
  }
  .component-scroll td {
    white-space: nowrap;
  }
  :is(summary, .component-scroll):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @media (max-width: 600px) {
    .vector-equation {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1rem;
    }
  }
</style>
