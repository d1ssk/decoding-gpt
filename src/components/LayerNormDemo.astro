---
import data from '../../public/site/data/nanogpt/residual-stream.json';
import { barsPath, layerNorm, residualUi } from '../lib/residual';
import type { Language } from '../lib/site';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const ui = residualUi[lang];
const { input, weight } = data.layerNorm;
const result = layerNorm(input, weight);
const plot = { width: 600, height: 104, zeroY: 52, scale: 12, limit: 48 };
const ticks = [-4, -2, 0, 2, 4];
const charts = [
  { key: 'input', label: ui.input, values: input },
  {
    key: 'normalized',
    label: ui.normalized,
    values: result.normalized,
  },
  { key: 'output', label: ui.output, values: result.output },
].map((chart) => {
  const mean =
    chart.values.reduce((sum, value) => sum + value, 0) / input.length;
  const std = Math.sqrt(
    chart.values.reduce((sum, value) => sum + (value - mean) ** 2, 0) /
      input.length,
  );
  return { ...chart, mean: Math.abs(mean) < 5e-5 ? 0 : mean, std };
});
const payload = JSON.stringify({ input, weight, plot });
---

<figure class="layer-norm" data-layer-norm data-payload={payload}>
  <figcaption>{ui.layerNormCaption}</figcaption>
  <p class="note">{ui.layerNormNote}</p>
  <p class="note">{ui.layerNormScaleNote}</p>
  <div class="controls">
    <label>
      {ui.shift}: <output data-shift-value>0.00</output>
      <input
        data-shift
        type="range"
        min="-0.25"
        max="0.25"
        step="0.01"
        value="0"
        disabled
      />
    </label>
    <label>
      {ui.scale}: <output data-scale-value>1.00</output>
      <input
        data-scale
        type="range"
        min="0.25"
        max="4"
        step="0.05"
        value="1"
        disabled
      />
    </label>
  </div>
  {charts.map((chart) => (
    <div class="chart">
      <p>
        {chart.label}
        <span class="stats">
          <span>
            {ui.mean}{' '}
            <span data-stat={`${chart.key}-mean`}>{chart.mean.toFixed(4)}</span>
          </span>
          <span>
            {ui.std}{' '}
            <span data-stat={`${chart.key}-std`}>{chart.std.toFixed(4)}</span>
          </span>
        </span>
      </p>
      <div class="chart-plot">
        <div class="y-axis" aria-hidden="true">
          {ticks.map((tick) => (
            <span
              style={`top: ${((plot.zeroY - tick * plot.scale) / plot.height) * 100}%`}
            >
              {tick}
            </span>
          ))}
        </div>
        <svg
          viewBox={`0 0 ${plot.width} ${plot.height}`}
          preserveAspectRatio="none"
          role="img"
          aria-label={chart.label}
        >
          {ticks.map((tick) => (
            <path
              d={`M0 ${plot.zeroY - tick * plot.scale}H${plot.width}`}
              class={tick === 0 ? 'zero' : 'grid-line'}
            />
          ))}
          <path
            data-bars={chart.key}
            d={barsPath(
              chart.values,
              plot.width,
              plot.zeroY,
              plot.scale,
              plot.limit,
            )}
            class:list={['bars', chart.key]}
          />
        </svg>
      </div>
    </div>
  ))}
</figure>

<script>
  import { barsPath, layerNorm } from '../lib/residual';

  document
    .querySelectorAll<HTMLElement>('[data-layer-norm]')
    .forEach((root) => {
      const { input, weight, plot } = JSON.parse(root.dataset.payload!) as {
        input: number[];
        weight: number[];
        plot: {
          width: number;
          height: number;
          zeroY: number;
          scale: number;
          limit: number;
        };
      };
      const shift = root.querySelector<HTMLInputElement>('[data-shift]')!;
      const scale = root.querySelector<HTMLInputElement>('[data-scale]')!;
      const draw = (key: string, values: number[]) => {
        const path = root.querySelector<SVGPathElement>(
          `[data-bars="${key}"]`,
        )!;
        path.setAttribute(
          'd',
          barsPath(values, plot.width, plot.zeroY, plot.scale, plot.limit),
        );
      };
      const update = () => {
        const a = Number(shift.value);
        const s = Number(scale.value);
        root.querySelector('[data-shift-value]')!.textContent = a.toFixed(2);
        root.querySelector('[data-scale-value]')!.textContent = s.toFixed(2);
        const x = input.map((v) => v * s + a);
        const result = layerNorm(x, weight);
        for (const [key, values] of Object.entries({
          input: x,
          normalized: result.normalized,
          output: result.output,
        })) {
          draw(key, values);
          const mean =
            values.reduce((sum, value) => sum + value, 0) / values.length;
          const std = Math.sqrt(
            values.reduce((sum, value) => sum + (value - mean) ** 2, 0) /
              values.length,
          );
          root.querySelector(`[data-stat="${key}-mean"]`)!.textContent = (
            Math.abs(mean) < 5e-5 ? 0 : mean
          ).toFixed(4);
          root.querySelector(`[data-stat="${key}-std"]`)!.textContent =
            std.toFixed(4);
        }
      };
      [shift, scale].forEach((control) => {
        control.disabled = false;
        control.addEventListener('input', update);
      });
    });
</script>

<style>
  .layer-norm {
    border-block: 1px solid var(--line-strong);
    margin: 2rem 0;
    padding: 1.25rem 0;
  }
  figcaption {
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .note {
    color: var(--ink-secondary);
    font-size: 0.8rem;
  }
  .controls {
    display: grid;
    gap: 0.5rem 2rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    font-size: 0.85rem;
    margin: 1rem 0;
  }
  .controls label {
    display: grid;
    gap: 0.25rem;
  }
  output {
    font-family: var(--font-mono);
  }
  .chart p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    font-size: 0.8rem;
    margin: 0.75rem 0 0.25rem;
  }
  .stats {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }
  .stats > span {
    white-space: nowrap;
  }
  .chart-plot {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
  }
  .y-axis {
    position: relative;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .y-axis span {
    position: absolute;
    right: 0.5rem;
    transform: translateY(-50%);
  }
  .chart-plot svg {
    display: block;
    height: 6.5rem;
    width: 100%;
  }
  .zero {
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .grid-line {
    stroke: var(--line-strong);
    stroke-width: 0.5;
    opacity: 0.5;
  }
  .bars.input {
    fill: #a05a20;
  }
  .bars.normalized {
    fill: #276b92;
  }
  .bars.output {
    fill: var(--accent);
  }
</style>
