---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BackpropagationToy from '../../../components/backpropagation/BackpropagationToy';
import { motionUi } from '../../../lib/backpropagation-motion-i18n';
import { languages, localizedPath } from '../../../lib/site';
import type { Language } from '../../../lib/site';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props as { lang: Language };
const ui = motionUi[lang];
---

<BaseLayout
  {lang}
  title={ui.title}
  description={ui.description}
  canonicalPath={`${lang}/prototypes/backpropagation/`}
  alternateHref={localizedPath(
    lang === 'ja' ? 'en' : 'ja',
    'prototypes/backpropagation/',
  )}
>
  <div class="prototype-page">
    <header class="prototype-header">
      <p class="prototype-label">{ui.prototype}</p>
      <h1>{ui.title}</h1>
      <p class="prototype-intro">{ui.intro}</p>
    </header>
    <BackpropagationToy lang={lang} client:load />
    <footer class="prototype-footer">
      <span>{ui.sample}</span>
      <a href={localizedPath(lang, 'nanogpt/09-backpropagation/')}>
        {ui.relation}
      </a>
    </footer>
  </div>
</BaseLayout>

<style>
  .prototype-page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.8rem var(--page-gutter) 4rem;
  }
  .prototype-header {
    margin-bottom: 1.2rem;
  }
  .prototype-label {
    color: var(--accent);
    font: 0.7rem var(--font-mono);
    letter-spacing: 0.08em;
  }
  h1 {
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    font-weight: 550;
    letter-spacing: -0.035em;
    line-height: 1.3;
    margin: 1rem 0;
  }
  .prototype-intro {
    max-width: 48rem;
    color: var(--ink-secondary);
    font-size: 0.95rem;
    line-height: 1.85;
  }
  .prototype-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding-top: 1rem;
    font-size: 0.8rem;
    color: var(--ink-secondary);
  }
  .prototype-footer a {
    color: var(--accent);
  }
</style>
